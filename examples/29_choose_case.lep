(* 29_choose_case.lep - choose runs the case whose label equals the
   value. Labels are literals of one kind: numbers, quoted Text, or
   true/false. *)

ensure mode = "AUTO"

choose mode
case "AUTO"
    show "Running autonomously"
case "MANUAL"
    show "Under manual control"
otherwise
    show "Unknown mode"
done()

ensure gear = 2

choose gear
case 1
    show "First gear"
case 2
    show "Second gear"
otherwise
    show "No gear"
done()

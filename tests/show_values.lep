(* show: one value, many values, every kind of value *)
show "hello"
show ""
show
show 5
show 2.50
show 5kg
show "mass:" 5kg
show 5kg 3m "and" true
show "x" "" "y"
show 1 < 2 "ok"
show not true
show [1, 2, 3]
show "two
lines"
shape Point
    x: Number
    y: Number
done()
show Point(x = 1m, y = 2m)
make twice(n)
    done(n * 2)
done()
show twice(3) twice(4)
ensure a = [10, 20]
show a[0] a[1]
show "list" [1, 2] f_value(3) (4) 2 * (3)
make f_value(x)
    done(x)
done()
show a[0] - a[1] 7 - 2
show 1234567 1.0 0.1 + 0.2 1 / 3
show 123456789012345
show 1000000000000000
show 0.00009
show 1kg == 1000g 1m == 100cm 1s != 1ms

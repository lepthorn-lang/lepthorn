(* programs that must be rejected before anything runs, by eval and
   by check alike *)
ensure lc = sys::getenv("LEPTHORNC")
when lc == ""
    sys::fail("LEPTHORNC is not set - run this through lepthornc test")
done()
sys::mkdir("build/test/rejected")
ensure nl = text::from_code(10)

make try(lc, name, source)
    ensure q = text::from_code(34)
    ensure path = "build/test/rejected/" + name + ".lep"
    ensure log = "build/test/rejected/" + name + ".txt"
    ensure h = file::open(path, "w")
    file::write(h, source)
    file::close(h)
    ensure eval_status = sys::run(q + lc + q + " eval " + path + " > " + log + " 2>&1")
    ensure check_status = sys::run(q + lc + q + " check " + path + " > " + log + ".check 2>&1")
    ensure lh = file::open(log, "r")
    ensure out = file::load(lh, sys::file_size(log))
    file::close(lh)
    show name "eval:" eval_status "check:" check_status
    show text::slice(out, 0, text::length(out) - 1)
done()

try(lc, "stop_at_top", "show 1" + nl + "stop" + nl)
try(lc, "next_in_function", "make f()" + nl + "    next" + nl + "done()" + nl + "f()" + nl)
try(lc, "open_comment", "show 1" + nl + "(* never closed" + nl + "show 2" + nl)
try(lc, "loop_hz_zero", "loop_hz 0Hz" + nl + "    stop" + nl + "done()" + nl)
try(lc, "loop_hz_period", "loop_hz 10ms" + nl + "    stop" + nl + "done()" + nl)
try(lc, "case_mixed", "choose 1" + nl + "case 1" + nl + "    show 1" + nl + "case " + text::from_code(34) + "b" + text::from_code(34) + nl + "    show 2" + nl + "done()" + nl)
try(lc, "case_twice", "choose 1" + nl + "case 1" + nl + "    show 1" + nl + "case 1" + nl + "    show 2" + nl + "done()" + nl)
try(lc, "bitwise_vs_compare", "ensure a = 6" + nl + "show a & 3 == 2" + nl)
try(lc, "unit_add", "ensure d = 2kg + 3m" + nl + "show d" + nl)
try(lc, "unit_compare", "show 1kg < 2m" + nl)
try(lc, "unit_assign", "suppose speed = 2m / 1s" + nl + "speed = 5kg" + nl)
try(lc, "unit_in_call", "make add(a, b)" + nl + "    done(a + b)" + nl + "done()" + nl + "show add(2kg, 3m)" + nl)
try(lc, "unit_from_call", "make speed(d, t)" + nl + "    done(d / t)" + nl + "done()" + nl + "ensure v = speed(10m, 2s)" + nl + "show v + 1kg" + nl)
try(lc, "show_comma", "show 1, 2" + nl + "show 3" + nl)
try(lc, "text_open", "show 1" + nl + "show " + text::from_code(34) + "never closed" + nl)
try(lc, "comment_end_alone", "show 1" + nl + "*)" + nl)
try(lc, "comment_open_inside", "show 1" + nl + "(* a (* b *)" + nl + "show 2" + nl)
try(lc, "show_spaced_minus", "ensure a = 5" + nl + "ensure b = 3" + nl + "show a -b" + nl)
try(lc, "show_spaced_bracket", "ensure a = [1]" + nl + "show a [0]" + nl)
try(lc, "show_spaced_call", "make f(x)" + nl + "    done(x)" + nl + "done()" + nl + "show f (3)" + nl)
try(lc, "line_comment", "show 1 // one" + nl + "show 2 // two" + nl)
try(lc, "unit_equal", "show 1kg == 1m" + nl)
try(lc, "unit_not_equal", "show 1kg != 1m" + nl)
try(lc, "use_no_file", "show 1" + nl + "use " + text::from_code(34) + "no_such.lep" + text::from_code(34) + nl)
try(lc, "use_no_module", "use no::such" + nl)
try(lc, "no_unit", "show 2 3xq" + nl)
try(lc, "no_shape_field", "shape P" + nl + "    x: Number" + nl + "done()" + nl + "show P(y = 1)" + nl + "show Q(a = 1)" + nl)
try(lc, "no_builtin", "show text::lenght(1)" + nl + "show text::length(1, 2)" + nl)
try(lc, "syntax_error", "ensure a = 1" + nl + "show a +" + nl + "show 2" + nl)

(* an error in a file pulled in with `use` names that file and its line *)
ensure hh = file::open("build/test/rejected/helper.lep", "w")
file::write(hh, "make helper(n)" + nl + "    done(n * missing)" + nl + "done()" + nl)
file::close(hh)
try(lc, "error_in_used_file", "use " + text::from_code(34) + "helper.lep" + text::from_code(34) + nl + "show helper(2)" + nl)

    rt(ctx, "define internal i64 @lep_sys_now() {|entry:|  %t = call double @lep_now()|  %v = call i64 @lep.enc(double %t)|  ret i64 %v|}")
    rt(ctx, "define internal i32 @lep.pstrcmp(ptr %a, ptr %b) {|entry:|  %x = load ptr, ptr %a|  %y = load ptr, ptr %b|  %c = call i32 @strcmp(ptr %x, ptr %y)|  ret i32 %c|}")
    rt(ctx, "define internal i64 @lep_sys_list_dir(i64 %p) {|entry:|  %np = alloca i64|  %ip = alloca i64|  call void @lep.need(i64 %p, i32 1, ptr @.rt.fn_listdir, ptr @.rt.w_text)|  %pc = call ptr @lep.tchars(i64 %p)|  %arr = call ptr @malloc(i64 65536)|  store i64 0, ptr %np|  %d = call ptr @opendir(ptr %pc)|  %null = icmp eq ptr %d, null|  br i1 %null, label %fin, label %loop|loop:|  %e = call ptr @readdir(ptr %d)|  %end = icmp eq ptr %e, null|  br i1 %end, label %closed, label %body|body:|  %nm = getelementptr i8, ptr %e, i64 19|  %c1 = call i32 @strcmp(ptr %nm, ptr @.rt.s_dot)|  %c2 = call i32 @strcmp(ptr %nm, ptr @.rt.s_dotdot)|  %z1 = icmp eq i32 %c1, 0|  %z2 = icmp eq i32 %c2, 0|  %skip = or i1 %z1, %z2|  %n = load i64, ptr %np|  %full = icmp sge i64 %n, 8192|  %drop = or i1 %skip, %full|  br i1 %drop, label %loop, label %put|put:|  %copy = call ptr @strdup(ptr %nm)|  %slot = getelementptr ptr, ptr %arr, i64 %n|  store ptr %copy, ptr %slot|  %n1 = add i64 %n, 1|  store i64 %n1, ptr %np|  br label %loop|closed:|  %cl = call i32 @closedir(ptr %d)|  br label %fin")
    rt(ctx, "fin:|  %cnt = load i64, ptr %np|  call void @qsort(ptr %arr, i64 %cnt, i64 8, ptr @lep.pstrcmp)|  %zero = icmp eq i64 %cnt, 0|  %cap = select i1 %zero, i64 1, i64 %cnt|  %capv = call i64 @lep.num(i64 %cap)|  %ring = call i64 @lep_ring_create(i64 %capv)|  store i64 0, ptr %ip|  br label %fill|fill:|  %i = load i64, ptr %ip|  %done = icmp sge i64 %i, %cnt|  br i1 %done, label %out, label %one|one:|  %sp = getelementptr ptr, ptr %arr, i64 %i|  %s = load ptr, ptr %sp|  %t = call i64 @lep.cstr(ptr %s)|  %w = call i64 @lep_ring_write(i64 %ring, i64 %t)|  call void @free(ptr %s)|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %fill|out:|  call void @free(ptr %arr)|  ret i64 %ring|}")
    rt(ctx, "define internal i64 @lep_sys_realpath(i64 %p) {|entry:|  call void @lep.need(i64 %p, i32 1, ptr @.rt.fn_realpath, ptr @.rt.w_text)|  %pc = call ptr @lep.tchars(i64 %p)|  %r = call ptr @realpath(ptr %pc, ptr null)|  %null = icmp eq ptr %r, null|  br i1 %null, label %same, label %ok|same:|  ret i64 %p|ok:|  %t = call i64 @lep.cstr(ptr %r)|  call void @free(ptr %r)|  ret i64 %t|}")
done()

make cg_rt_time(ctx)
    ensure nl = text::from_code(10)
    rt_str(ctx, "f_period", "`%s` requires a time (e.g. 10ms) or frequency (e.g. 100Hz) quantity")
    rt_str(ctx, "w_hz", "loop_hz: the frequency")
    rt_str(ctx, "m_hz", "loop_hz: frequency must be greater than zero")
    rt_str(ctx, "f_deadline", "lepthorn: warning: LEC8016 Deadline Missed - took %.3fs, budget %.3fs" + nl)
    rt_str(ctx, "m_timeout", "lepthorn: warning: LEC8017 Timeout Expired" + nl)
    rt_str(ctx, "f_timeout_warn", "lepthorn: warning: LEC8017 Timeout Expired - waited %.3fs" + nl)
    rt_str(ctx, "m_prio", "priority must be a Number")
    rt(ctx, "@lep.dtime = internal constant [8 x i32] [i32 0, i32 0, i32 1, i32 0, i32 0, i32 0, i32 0, i32 0]|@lep.dfreq = internal constant [8 x i32] [i32 0, i32 0, i32 -1, i32 0, i32 0, i32 0, i32 0, i32 0]")
    rt(ctx, "define internal double @lep_now() {|entry:|  %ts = alloca [2 x i64]|  %r = call i32 @clock_gettime(i32 1, ptr %ts)|  %sec = load i64, ptr %ts|  %np = getelementptr i64, ptr %ts, i64 1|  %ns = load i64, ptr %np|  %s = sitofp i64 %sec to double|  %n = sitofp i64 %ns to double|  %nf = fmul double %n, 1.0e-9|  %t = fadd double %s, %nf|  ret double %t|}")
    rt(ctx, "define internal void @lep_sleep(double %s) {|entry:|  %ts = alloca [2 x i64]|  %pos = fcmp ogt double %s, 0.0|  br i1 %pos, label %go, label %out|go:|  %sec = fptosi double %s to i64|  %secd = sitofp i64 %sec to double|  %frac = fsub double %s, %secd|  %nsd = fmul double %frac, 1.0e9|  %ns = fptosi double %nsd to i64|  store i64 %sec, ptr %ts|  %np = getelementptr i64, ptr %ts, i64 1|  store i64 %ns, ptr %np|  %r = call i32 @nanosleep(ptr %ts, ptr null)|  br label %out|out:|  ret void|}")
    rt(ctx, "define internal double @lep_period(i64 %v, i64 %what) {|entry:|  %pv = alloca double|  %pd = alloca [8 x i32]|  %g = call i1 @lep.getq(i64 %v, ptr %pv, ptr %pd)|  br i1 %g, label %ok, label %bad|ok:|  %x = load double, ptr %pv|  %t = call i1 @lep.dimeq(ptr %pd, ptr @lep.dtime)|  br i1 %t, label %rt, label %c2|rt:|  ret double %x|c2:|  %f = call i1 @lep.dimeq(ptr %pd, ptr @lep.dfreq)|  br i1 %f, label %rf, label %bad|rf:|  %inv = fdiv double 1.0, %x|  ret double %inv|bad:|  %wp = call ptr @lep.tchars(i64 %what)|  call void @lep.die1(ptr @.rt.f_period, ptr %wp)|  unreachable|}")
    rt(ctx, "define internal double @lep_hz_period(i64 %v) {|entry:|  %hz = call i64 @lep.whole(i64 %v, ptr @.rt.w_hz)|  %pos = icmp sgt i64 %hz, 0|  br i1 %pos, label %ok, label %bad|bad:|  call void @lep.die(ptr @.rt.m_hz)|  unreachable|ok:|  %d = sitofp i64 %hz to double|  %p = fdiv double 1.0, %d|  ret double %p|}")
    rt(ctx, "define internal void @lep_release_wait(double %st, double %per, i64 %it) {|entry:|  %itd = sitofp i64 %it to double|  %off = fmul double %per, %itd|  %target = fadd double %st, %off|  %now = call double @lep_now()|  %later = fcmp ogt double %target, %now|  br i1 %later, label %nap, label %out|nap:|  %dt = fsub double %target, %now|  call void @lep_sleep(double %dt)|  br label %out|out:|  ret void|}")
    rt(ctx, "define internal i32 @lep_is_bool(i64 %v) {|entry:|  %b = call i1 @lep.isbool(i64 %v)|  %r = zext i1 %b to i32|  ret i32 %r|}")
    rt(ctx, "define internal void @lep_deadline_check(double %st, double %bud) {|entry:|  %now = call double @lep_now()|  %el = fsub double %now, %st|  %over = fcmp ogt double %el, %bud|  br i1 %over, label %warn, label %out|warn:|  %w = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.f_deadline, double %el, double %bud)|  br label %out|out:|  ret void|}")
    rt(ctx, "define internal void @lep_timeout_check(double %st, double %bud) {|entry:|  %now = call double @lep_now()|  %el = fsub double %now, %st|  %over = fcmp ogt double %el, %bud|  br i1 %over, label %warn, label %out|warn:|  %w = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.m_timeout)|  br label %out|out:|  ret void|}")
    rt(ctx, "define internal void @lep_timeout_warn(double %bud) {|entry:|  %w = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.f_timeout_warn, double %bud)|  ret void|}")
    rt(ctx, "define internal i64 @lep_pick_task(ptr %prios, ptr %used, i64 %n) {|entry:|  %ip = alloca i64|  %bestp = alloca i64|  %bpv = alloca double|  %qv = alloca double|  %qd = alloca [8 x i32]|  store i64 0, ptr %ip|  store i64 -1, ptr %bestp|  store double 0.0, ptr %bpv|  br label %loop|loop:|  %i = load i64, ptr %ip|  %done = icmp sge i64 %i, %n|  br i1 %done, label %fin, label %body|body:|  %up = getelementptr i8, ptr %used, i64 %i|  %u = load i8, ptr %up|  %isused = icmp ne i8 %u, 0|  br i1 %isused, label %next, label %cand|cand:|  %pp = getelementptr i64, ptr %prios, i64 %i|  %pv = load i64, ptr %pp|  %g = call i1 @lep.getq(i64 %pv, ptr %qv, ptr %qd)|  br i1 %g, label %cmp, label %bad|bad:|  call void @lep.die(ptr @.rt.m_prio)|  unreachable|cmp:|  %x = load double, ptr %qv|  %b = load i64, ptr %bestp|  %none = icmp slt i64 %b, 0|  %bv = load double, ptr %bpv|  %gt = fcmp ogt double %x, %bv|  %take = or i1 %none, %gt|  br i1 %take, label %set, label %next|set:|  store i64 %i, ptr %bestp|  store double %x, ptr %bpv|  br label %next|next:|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|fin:|  %b2 = load i64, ptr %bestp|  %has = icmp sge i64 %b2, 0|  br i1 %has, label %mark, label %out|mark:|  %mp = getelementptr i8, ptr %used, i64 %b2|  store i8 1, ptr %mp|  br label %out|out:|  ret i64 %b2|}")
done()

make cg_rt_input(ctx)
    rt_str(ctx, "f_readp", "read %s: ")
    rt_str(ctx, "f_takep", "take %s: ")
    rt_str(ctx, "m_eof", "end of input")
    rt_str(ctx, "f_take_parse", "`take`: could not parse input '%s'")
    rt_str(ctx, "f_unit", "unknown unit suffix '%s'")
    cg_rt_units(ctx)
    rt(ctx, "define internal ptr @lep.readline() {|entry:|  %capp = alloca i64|  %np = alloca i64|  %bufp = alloca ptr|  store i64 256, ptr %capp|  store i64 0, ptr %np|  %b0 = call ptr @malloc(i64 256)|  store ptr %b0, ptr %bufp|  br label %loop|loop:|  %c = call i32 @getchar()|  %eof = icmp eq i32 %c, -1|  %nlc = icmp eq i32 %c, 10|  %stop = or i1 %eof, %nlc|  br i1 %stop, label %end, label %add|add:|  %n = load i64, ptr %np|  %cap = load i64, ptr %capp|  %n1 = add i64 %n, 1|  %full = icmp sge i64 %n1, %cap|  br i1 %full, label %grow, label %put|grow:|  %cap2 = mul i64 %cap, 2|  store i64 %cap2, ptr %capp|  %ob = load ptr, ptr %bufp|  %nb = call ptr @realloc(ptr %ob, i64 %cap2)|  store ptr %nb, ptr %bufp|  br label %put|put:|  %b = load ptr, ptr %bufp|  %n2 = load i64, ptr %np|  %dp = getelementptr i8, ptr %b, i64 %n2|  %ch = trunc i32 %c to i8|  store i8 %ch, ptr %dp|  %n3 = add i64 %n2, 1|  store i64 %n3, ptr %np|  br label %loop|end:|  %nn = load i64, ptr %np|  %zero = icmp eq i64 %nn, 0|  %dead = and i1 %eof, %zero|  br i1 %dead, label %dieeof, label %fin|dieeof:|  call void @lep.die(ptr @.rt.m_eof)|  unreachable|fin:|  %bf = load ptr, ptr %bufp|  %ep = getelementptr i8, ptr %bf, i64 %nn|  store i8 0, ptr %ep|  ret ptr %bf|}")
    rt(ctx, "define internal i64 @lep_sys_read(i64 %name) {|entry:|  %np = call ptr @lep.tchars(i64 %name)|  %w = call i32 (ptr, ...) @printf(ptr @.rt.f_readp, ptr %np)|  %f = call i32 @fflush(ptr null)|  %s = call ptr @lep.readline()|  %t = call i64 @lep.cstr(ptr %s)|  call void @free(ptr %s)|  ret i64 %t|}")
    rt(ctx, "define internal i1 @lep.isblank(i8 %c) {|entry:|  %a = icmp eq i8 %c, 32|  %b = icmp eq i8 %c, 9|  %d = icmp eq i8 %c, 13|  %ab = or i1 %a, %b|  %r = or i1 %ab, %d|  ret i1 %r|}")
    rt(ctx, "define internal i64 @lep_sys_take(i64 %name) {|entry:|  %ip = alloca i64|  %sp = alloca ptr|  %numbuf = alloca [64 x i8]|  %np = call ptr @lep.tchars(i64 %name)|  %w = call i32 (ptr, ...) @printf(ptr @.rt.f_takep, ptr %np)|  %f = call i32 @fflush(ptr null)|  %raw = call ptr @lep.readline()|  store ptr %raw, ptr %sp|  br label %lead|lead:|  %s = load ptr, ptr %sp|  %c = load i8, ptr %s|  %bl = call i1 @lep.isblank(i8 %c)|  br i1 %bl, label %adv, label %trail0|adv:|  %s1 = getelementptr i8, ptr %s, i64 1|  store ptr %s1, ptr %sp|  br label %lead|trail0:|  %s2 = load ptr, ptr %sp|  %n = call i64 @strlen(ptr %s2)|  store i64 %n, ptr %ip|  br label %trail|trail:|  %k = load i64, ptr %ip|  %kz = icmp eq i64 %k, 0|  br i1 %kz, label %tdone, label %tchk|tchk:|  %km = sub i64 %k, 1|  %cp = getelementptr i8, ptr %s2, i64 %km|  %cc = load i8, ptr %cp|  %tb = call i1 @lep.isblank(i8 %cc)|  br i1 %tb, label %tcut, label %tdone|tcut:|  store i8 0, ptr %cp|  store i64 %km, ptr %ip|  br label %trail")
    rt(ctx, "tdone:|  store i64 0, ptr %ip|  br label %scan|scan:|  %i = load i64, ptr %ip|  %cp2 = getelementptr i8, ptr %s2, i64 %i|  %ch = load i8, ptr %cp2|  %dg1 = icmp sge i8 %ch, 48|  %dg2 = icmp sle i8 %ch, 57|  %dg = and i1 %dg1, %dg2|  %mi = icmp eq i8 %ch, 45|  %dt = icmp eq i8 %ch, 46|  %md = or i1 %mi, %dt|  %ok = or i1 %dg, %md|  %room = icmp slt i64 %i, 63|  %go = and i1 %ok, %room|  br i1 %go, label %sadv, label %sdone|sadv:|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %scan|sdone:|  %i2 = load i64, ptr %ip|  %zero = icmp eq i64 %i2, 0|  br i1 %zero, label %bad, label %parse|bad:|  call void @lep.die1(ptr @.rt.f_take_parse, ptr %raw)|  unreachable|parse:|  %m = call ptr @memcpy(ptr %numbuf, ptr %s2, i64 %i2)|  %nend = getelementptr i8, ptr %numbuf, i64 %i2|  store i8 0, ptr %nend|  %v = call double @strtod(ptr %numbuf, ptr null)|  %unit = getelementptr i8, ptr %s2, i64 %i2|  %u0 = load i8, ptr %unit|  %nounit = icmp eq i8 %u0, 0|  br i1 %nounit, label %plain, label %lookup|plain:|  %r0 = call i64 @lep.enc(double %v)|  ret i64 %r0")
    rt(ctx, "lookup:|  store i64 0, ptr %ip|  br label %ul|ul:|  %j = load i64, ptr %ip|  %udone = icmp sge i64 %j, 20|  br i1 %udone, label %nounitfound, label %ub|ub:|  %namep = getelementptr [20 x %lep.U], ptr @lep.units, i64 0, i64 %j, i32 0|  %uname = load ptr, ptr %namep|  %cmp = call i32 @strcmp(ptr %uname, ptr %unit)|  %hit = icmp eq i32 %cmp, 0|  br i1 %hit, label %found, label %unext|unext:|  %j1 = add i64 %j, 1|  store i64 %j1, ptr %ip|  br label %ul|found:|  %scp = getelementptr [20 x %lep.U], ptr @lep.units, i64 0, i64 %j, i32 1|  %scale = load double, ptr %scp|  %dimp = getelementptr [20 x %lep.U], ptr @lep.units, i64 0, i64 %j, i32 2|  %x = fmul double %v, %scale|  %r1 = call i64 @lep.mkq(double %x, ptr %dimp)|  ret i64 %r1|nounitfound:|  call void @lep.die1(ptr @.rt.f_unit, ptr %unit)|  unreachable|}")
done()

(* the same 20-entry unit table as build_unit_table, for `take` input *)
make cg_rt_units(ctx)
    suppose line = "@lep.units = internal constant [20 x %lep.U] ["
    line = line + cg_rt_unit(ctx, "kg", "1.0", "1", "0", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "g", "0.001", "1", "0", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "t", "1000.0", "1", "0", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "m", "1.0", "0", "1", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "km", "1000.0", "0", "1", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "cm", "0.01", "0", "1", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "mm", "0.001", "0", "1", "0", "0") + ", "
    line = line + cg_rt_unit(ctx, "s", "1.0", "0", "0", "1", "0") + ", "
    line = line + cg_rt_unit(ctx, "ms", "0.001", "0", "0", "1", "0") + ", "
    line = line + cg_rt_unit(ctx, "min", "60.0", "0", "0", "1", "0") + ", "
    line = line + cg_rt_unit(ctx, "h", "3600.0", "0", "0", "1", "0") + ", "
    line = line + cg_rt_unit(ctx, "N", "1.0", "1", "1", "-2", "0") + ", "
    line = line + cg_rt_unit(ctx, "kN", "1000.0", "1", "1", "-2", "0") + ", "
    line = line + cg_rt_unit(ctx, "MN", "1000000.0", "1", "1", "-2", "0") + ", "
    line = line + cg_rt_unit(ctx, "mps", "1.0", "0", "1", "-1", "0") + ", "
    line = line + cg_rt_unit(ctx, "Hz", "1.0", "0", "0", "-1", "0") + ", "
    line = line + cg_rt_unit(ctx, "kHz", "1000.0", "0", "0", "-1", "0") + ", "
    line = line + cg_rt_unit(ctx, "rad", "1.0", "0", "0", "0", "1") + ", "
    line = line + cg_rt_unit(ctx, "degree", "0.017453292519943295", "0", "0", "0", "1") + ", "
    line = line + cg_rt_unit(ctx, "deg", "0.017453292519943295", "0", "0", "0", "1")
    cg_global(ctx, line + "]")
done()

(* A/K/mol/cd exponents are 0 for every unit in this table *)
make cg_rt_unit(ctx, name, scale, kg, m, s, rad)
    rt_str(ctx, "u_" + name, name)
    done("%lep.U { ptr @.rt.u_" + name + ", double " + scale + ", [8 x i32] [i32 " + kg + ", i32 " + m + ", i32 " + s + ", i32 0, i32 0, i32 0, i32 0, i32 " + rad + "] }")
done()

make cg_rt_engines(ctx)
    rt_str(ctx, "m_gravity", "force::gravity: argument must have mass dimension [kg]")
    rt_str(ctx, "m_accel", "force::acceleration: arguments must be a force [N] and a mass [kg]")
    rt_str(ctx, "m_vel", "motion::velocity: arguments must be a length [m] and a time [s]")
    rt_str(ctx, "m_rot", "matrix::rotationZ: argument must have angle dimension [rad]")
    rt_str(ctx, "m_vector", "vector: expected a quantity value")
    rt(ctx, "@lep.dmass = internal constant [8 x i32] [i32 1, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0]|@lep.dlen = internal constant [8 x i32] [i32 0, i32 1, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0]|@lep.dforce = internal constant [8 x i32] [i32 1, i32 1, i32 -2, i32 0, i32 0, i32 0, i32 0, i32 0]|@lep.daccel = internal constant [8 x i32] [i32 0, i32 1, i32 -2, i32 0, i32 0, i32 0, i32 0, i32 0]|@lep.dvel = internal constant [8 x i32] [i32 0, i32 1, i32 -1, i32 0, i32 0, i32 0, i32 0, i32 0]|@lep.dangle = internal constant [8 x i32] [i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 1]")
    rt(ctx, "define internal i64 @lep_force_gravity(i64 %m) {|entry:|  %pv = alloca double|  %pd = alloca [8 x i32]|  %g = call i1 @lep.getq(i64 %m, ptr %pv, ptr %pd)|  br i1 %g, label %chk, label %bad|chk:|  %ok = call i1 @lep.dimeq(ptr %pd, ptr @lep.dmass)|  br i1 %ok, label %good, label %bad|bad:|  call void @lep.die(ptr @.rt.m_gravity)|  unreachable|good:|  %x = load double, ptr %pv|  %f = fmul double %x, 9.80665|  %r = call i64 @lep.mkq(double %f, ptr @lep.dforce)|  ret i64 %r|}")

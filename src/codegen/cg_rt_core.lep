(* cg_rt_core.lep - the native runtime, part 1: written as LLVM IR by
   Lepthorn itself and emitted into every compiled program (no separate
   runtime library to install or link). Only libc/libm are called.

   Value word (i64): Number = IEEE bits + 2^49 (NaNs canonical),
   Boolean 6/7, "no value" 10, else a raw pointer to a heap object
   whose first i32 is its kind:
     1 Text   {kind, aux, len@8, bytes@16}
     2 Qty    {kind, aux, value@8 (double), dims@16 (8 x i32)}
     3 shape  {kind, shape id@4, nslots@8, slots@16}
     4 Array  {kind, aux, n@8, elems@16}
     5/6/7 Ring/Queue/Stack {kind, aux, cap@8, head@16, tail@24, count@32, buf@40}
     8 Handle {kind, fd@4 (i32), valid@8, mode@16 (Text)}
     9 Vector {kind, aux, x@8, y@16, z@24}
     10 Matrix {kind, aux, 9 doubles@8}

   Each rt() string is one or more IR lines, '|' separating lines. *)

use codegen::cg_core

make rt(ctx, s)
    ensure len = text::length(s)
    ensure nl = text::from_code(10)
    suppose outs = ""
    suppose seg = 0
    suppose i = 0
    repeat
        when i >= len
            stop
        done()
        when text::char_at(s, i) == "|"
            outs = outs + text::slice(s, seg, i) + nl
            seg = i + 1
        done()
        i = i + 1
    done()
    cg_global(ctx, outs + text::slice(s, seg, len))
done()

make rt_str(ctx, name, s)
    cg_cstr_global(ctx, "@.rt." + name, s)
done()

make cg_rt_header()
    ensure nl = text::from_code(10)
    ensure q = text::from_code(34)
    suppose h = "; generated by lepthornc" + nl + "source_filename = " + q + "lepthorn" + q + nl
    h = h + "%lep.T1 = type { i32, i32, i64, [8 x i8] }" + nl
    h = h + "%lep.U = type { ptr, double, [8 x i32] }" + nl
    h = h + "declare ptr @malloc(i64)" + nl + "declare ptr @calloc(i64, i64)" + nl + "declare ptr @realloc(ptr, i64)" + nl + "declare void @free(ptr)" + nl
    h = h + "declare ptr @memcpy(ptr, ptr, i64)" + nl + "declare ptr @memset(ptr, i32, i64)" + nl + "declare i32 @memcmp(ptr, ptr, i64)" + nl
    h = h + "declare i64 @strlen(ptr)" + nl + "declare i32 @strcmp(ptr, ptr)" + nl + "declare ptr @strcpy(ptr, ptr)" + nl + "declare ptr @strcat(ptr, ptr)" + nl
    h = h + "declare i32 @printf(ptr, ...)" + nl + "declare i32 @dprintf(i32, ptr, ...)" + nl + "declare i32 @snprintf(ptr, i64, ptr, ...)" + nl
    h = h + "declare i32 @fflush(ptr)" + nl + "declare i32 @putchar(i32)" + nl + "declare i64 @fwrite(ptr, i64, i64, ptr)" + nl + "declare i32 @setvbuf(ptr, ptr, i32, i64)" + nl
    h = h + "declare void @exit(i32)" + nl + "declare double @strtod(ptr, ptr)" + nl + "declare double @fmod(double, double)" + nl + "declare double @pow(double, double)" + nl + "declare double @cos(double)" + nl + "declare double @sin(double)" + nl
    h = h + "declare i32 @open(ptr, i32, ...)" + nl + "declare i64 @read(i32, ptr, i64)" + nl + "declare i64 @write(i32, ptr, i64)" + nl + "declare i32 @close(i32)" + nl + "declare i32 @unlink(ptr)" + nl + "declare i32 @stat(ptr, ptr)" + nl
    h = h + "declare ptr @__errno_location()" + nl + "declare i32 @system(ptr)" + nl + "declare i64 @readlink(ptr, ptr, i64)" + nl + "declare ptr @getcwd(ptr, i64)" + nl + "declare ptr @getenv(ptr)" + nl + "declare i32 @mkdir(ptr, i32)" + nl + "declare ptr @realpath(ptr, ptr)" + nl
    h = h + "declare i32 @clock_gettime(i32, ptr)" + nl + "declare i32 @nanosleep(ptr, ptr)" + nl + "declare i32 @getchar()" + nl
    h = h + "declare i32 @fprintf(ptr, ptr, ...)" + nl + "declare i32 @fputc(i32, ptr)" + nl + "declare ptr @open_memstream(ptr, ptr)" + nl + "declare i32 @fclose(ptr)" + nl
    h = h + "declare i32 @chdir(ptr)" + nl + "declare i32 @setenv(ptr, ptr, i32)" + nl
    h = h + "declare ptr @popen(ptr, ptr)" + nl + "declare i32 @pclose(ptr)" + nl + "declare i64 @fread(ptr, i64, i64, ptr)" + nl
    h = h + "declare ptr @opendir(ptr)" + nl + "declare ptr @readdir(ptr)" + nl + "declare i32 @closedir(ptr)" + nl + "declare ptr @strdup(ptr)" + nl + "declare void @qsort(ptr, i64, i64, ptr)" + nl
    h = h + "@stdout = external global ptr" + nl
    done(h)
done()

make cg_rt_all(ctx)
    cg_rt_core(ctx)
    cg_rt_ops(ctx)
    cg_rt_data(ctx)
    cg_rt_text(ctx)
    cg_rt_show(ctx)
    cg_rt_io(ctx)
done()

make cg_rt_core(ctx)
    ensure nl = text::from_code(10)
    rt(ctx, "@lep.hp = internal global ptr null|@lep.he = internal global ptr null|@lep_depth = internal global i64 0|@lep.ferr = internal global i64 0|@lep.argc = internal global i32 0|@lep.argv = internal global ptr null")
    rt(ctx, "@lep.dim0 = internal constant [8 x i32] zeroinitializer")
    cg_rt_chars(ctx)
    rt_str(ctx, "f_die", "lepthorn: runtime error: %s" + nl)
    rt_str(ctx, "f_expect", "%s: expected %s, got %s")
    rt_str(ctx, "m_oom", "out of memory")
    rt_str(ctx, "kn_num", "Number")
    rt_str(ctx, "kn_bool", "Boolean")
    rt_str(ctx, "kn_nov", "no value")
    rt_str(ctx, "kn_text", "Text")
    rt_str(ctx, "kn_shape", "shape")
    rt_str(ctx, "kn_arr", "Array")
    rt_str(ctx, "kn_ring", "RingBuffer")
    rt_str(ctx, "kn_queue", "Queue")
    rt_str(ctx, "kn_stack", "Stack")
    rt_str(ctx, "kn_handle", "Handle")
    rt_str(ctx, "kn_vec", "Vector")
    rt_str(ctx, "kn_mat", "Matrix")
    rt_str(ctx, "kn_unk", "unknown value")
    rt(ctx, "define internal i32 @lep.kind(i64 %v) {|entry:|  %lo = icmp uge i64 %v, 4096|  %hi = icmp ult i64 %v, 562949953421312|  %isobj = and i1 %lo, %hi|  br i1 %isobj, label %obj, label %none|obj:|  %p = inttoptr i64 %v to ptr|  %k = load i32, ptr %p|  ret i32 %k|none:|  ret i32 0|}")
    rt(ctx, "define internal i1 @lep.isnum(i64 %v) {|entry:|  %r = icmp uge i64 %v, 562949953421312|  ret i1 %r|}")
    rt(ctx, "define internal i1 @lep.isbool(i64 %v) {|entry:|  %a = icmp eq i64 %v, 6|  %b = icmp eq i64 %v, 7|  %r = or i1 %a, %b|  ret i1 %r|}")
    rt(ctx, "define internal double @lep.dec(i64 %v) {|entry:|  %b = sub i64 %v, 562949953421312|  %d = bitcast i64 %b to double|  ret double %d|}")
    rt(ctx, "define internal i64 @lep.enc(double %d) {|entry:|  %nan = fcmp uno double %d, %d|  %b = bitcast double %d to i64|  %c = select i1 %nan, i64 9221120237041090560, i64 %b|  %r = add i64 %c, 562949953421312|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep.num(i64 %n) {|entry:|  %d = sitofp i64 %n to double|  %r = call i64 @lep.enc(double %d)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep.bool(i1 %b) {|entry:|  %r = select i1 %b, i64 7, i64 6|  ret i64 %r|}")
    rt(ctx, "define internal ptr @lep.at(i64 %v, i64 %off) {|entry:|  %p = inttoptr i64 %v to ptr|  %q = getelementptr i8, ptr %p, i64 %off|  ret ptr %q|}")
    rt(ctx, "define internal i64 @lep.ld(i64 %v, i64 %off) {|entry:|  %q = call ptr @lep.at(i64 %v, i64 %off)|  %r = load i64, ptr %q|  ret i64 %r|}")
    rt(ctx, "define internal void @lep.st(i64 %v, i64 %off, i64 %x) {|entry:|  %q = call ptr @lep.at(i64 %v, i64 %off)|  store i64 %x, ptr %q|  ret void|}")
    rt(ctx, "define internal ptr @lep.alloc(i64 %n) {|entry:|  %n1 = add i64 %n, 15|  %n2 = and i64 %n1, -16|  %cur = load ptr, ptr @lep.hp|  %end = load ptr, ptr @lep.he|  %ci = ptrtoint ptr %cur to i64|  %ei = ptrtoint ptr %end to i64|  %room = sub i64 %ei, %ci|  %fits = icmp uge i64 %room, %n2|  %live = icmp ne ptr %cur, null|  %ok = and i1 %fits, %live|  br i1 %ok, label %fast, label %slow")
    rt(ctx, "slow:|  %big = icmp ugt i64 %n2, 67108864|  %sz = select i1 %big, i64 %n2, i64 67108864|  %blk = call ptr @malloc(i64 %sz)|  %null = icmp eq ptr %blk, null|  br i1 %null, label %oom, label %got|oom:|  call void @lep.die(ptr @.rt.m_oom)|  unreachable|got:|  %be = getelementptr i8, ptr %blk, i64 %sz|  store ptr %be, ptr @lep.he|  %nb = getelementptr i8, ptr %blk, i64 %n2|  store ptr %nb, ptr @lep.hp|  ret ptr %blk|fast:|  %nc = getelementptr i8, ptr %cur, i64 %n2|  store ptr %nc, ptr @lep.hp|  ret ptr %cur|}")
    rt(ctx, "define internal void @lep.die(ptr %msg) {|entry:|  %f = call i32 @fflush(ptr null)|  %w = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.f_die, ptr %msg)|  call void @exit(i32 1)|  unreachable|}")
    rt(ctx, "define internal void @lep.die1(ptr %fmt, ptr %a) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.die2(ptr %fmt, ptr %a, ptr %b) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a, ptr %b)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.die3(ptr %fmt, ptr %a, ptr %b, ptr %c) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a, ptr %b, ptr %c)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.diei(ptr %fmt, i64 %a) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, i64 %a)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.dieii(ptr %fmt, i64 %a, i64 %b) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, i64 %a, i64 %b)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.dieiii(ptr %fmt, i64 %a, i64 %b, i64 %c) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, i64 %a, i64 %b, i64 %c)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.diesi(ptr %fmt, ptr %a, i64 %b) {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a, i64 %b)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal ptr @lep.kname(i64 %v) {|entry:|  %isn = icmp uge i64 %v, 562949953421312|  br i1 %isn, label %k2, label %c1|c1:|  %b1 = icmp eq i64 %v, 6|  %b2 = icmp eq i64 %v, 7|  %bb = or i1 %b1, %b2|  br i1 %bb, label %kb, label %c2|kb:|  ret ptr @.rt.kn_bool|c2:|  %nv = icmp eq i64 %v, 10|  br i1 %nv, label %kn, label %c3|kn:|  ret ptr @.rt.kn_nov")
    rt(ctx, "c3:|  %k = call i32 @lep.kind(i64 %v)|  switch i32 %k, label %unk [ i32 1, label %k1 i32 2, label %k2 i32 3, label %k3 i32 4, label %k4 i32 5, label %k5 i32 6, label %k6 i32 7, label %k7 i32 8, label %k8 i32 9, label %k9 i32 10, label %k10 ]|k1:|  ret ptr @.rt.kn_text|k2:|  ret ptr @.rt.kn_num|k3:|  ret ptr @.rt.kn_shape|k4:|  ret ptr @.rt.kn_arr|k5:|  ret ptr @.rt.kn_ring|k6:|  ret ptr @.rt.kn_queue|k7:|  ret ptr @.rt.kn_stack|k8:|  ret ptr @.rt.kn_handle|k9:|  ret ptr @.rt.kn_vec|k10:|  ret ptr @.rt.kn_mat|unk:|  ret ptr @.rt.kn_unk|}")
    rt(ctx, "define internal void @lep.need(i64 %v, i32 %kind, ptr %fn, ptr %what) {|entry:|  %k = call i32 @lep.kind(i64 %v)|  %ok = icmp eq i32 %k, %kind|  br i1 %ok, label %good, label %bad|good:|  ret void|bad:|  %kn = call ptr @lep.kname(i64 %v)|  call void @lep.die3(ptr @.rt.f_expect, ptr %fn, ptr %what, ptr %kn)|  unreachable|}")
    rt(ctx, "define internal ptr @lep.tchars(i64 %v) {|entry:|  %p = call ptr @lep.at(i64 %v, i64 16)|  ret ptr %p|}")
    rt(ctx, "define internal i64 @lep.tlen(i64 %v) {|entry:|  %n = call i64 @lep.ld(i64 %v, i64 8)|  ret i64 %n|}")
    rt(ctx, "define internal i64 @lep.charv(i8 %b) {|entry:|  %bi = zext i8 %b to i64|  %cp = getelementptr [256 x %lep.T1], ptr @lep.chars, i64 0, i64 %bi|  %v = ptrtoint ptr %cp to i64|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep.text_alloc(i64 %len) {|entry:|  %sz = add i64 %len, 17|  %p = call ptr @lep.alloc(i64 %sz)|  store i32 1, ptr %p|  %ap = getelementptr i8, ptr %p, i64 4|  store i32 0, ptr %ap|  %lp = getelementptr i8, ptr %p, i64 8|  store i64 %len, ptr %lp|  %sp = getelementptr i8, ptr %p, i64 16|  %ep = getelementptr i8, ptr %sp, i64 %len|  store i8 0, ptr %ep|  %v = ptrtoint ptr %p to i64|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep.text_new(ptr %src, i64 %len) {|entry:|  %one = icmp eq i64 %len, 1|  br i1 %one, label %ch, label %gen|ch:|  %b = load i8, ptr %src|  %cv = call i64 @lep.charv(i8 %b)|  ret i64 %cv|gen:|  %t = call i64 @lep.text_alloc(i64 %len)|  %d = call ptr @lep.tchars(i64 %t)|  %m = call ptr @memcpy(ptr %d, ptr %src, i64 %len)|  ret i64 %t|}")
    rt(ctx, "define internal i64 @lep.cstr(ptr %s) {|entry:|  %n = call i64 @strlen(ptr %s)|  %t = call i64 @lep.text_new(ptr %s, i64 %n)|  ret i64 %t|}")
    rt(ctx, "define internal i32 @lep.tcmp(i64 %a, i64 %b) {|entry:|  %la = call i64 @lep.tlen(i64 %a)|  %lb = call i64 @lep.tlen(i64 %b)|  %lt = icmp ult i64 %la, %lb|  %m = select i1 %lt, i64 %la, i64 %lb|  %pa = call ptr @lep.tchars(i64 %a)|  %pb = call ptr @lep.tchars(i64 %b)|  %c = call i32 @memcmp(ptr %pa, ptr %pb, i64 %m)|  %z = icmp eq i32 %c, 0|  br i1 %z, label %bylen, label %sign|sign:|  %neg = icmp slt i32 %c, 0|  %s = select i1 %neg, i32 -1, i32 1|  ret i32 %s|bylen:|  %g = icmp ugt i64 %la, %lb|  %gi = zext i1 %g to i32|  %li = zext i1 %lt to i32|  %r = sub i32 %gi, %li|  ret i32 %r|}")
    rt(ctx, "define internal i64 @lep.concat(i64 %a, i64 %b) {|entry:|  %la = call i64 @lep.tlen(i64 %a)|  %lb = call i64 @lep.tlen(i64 %b)|  %az = icmp eq i64 %la, 0|  br i1 %az, label %retb, label %c1|retb:|  ret i64 %b|c1:|  %bz = icmp eq i64 %lb, 0|  br i1 %bz, label %reta, label %go|reta:|  ret i64 %a|go:|  %n = add i64 %la, %lb|  %t = call i64 @lep.text_alloc(i64 %n)|  %d = call ptr @lep.tchars(i64 %t)|  %pa = call ptr @lep.tchars(i64 %a)|  %m1 = call ptr @memcpy(ptr %d, ptr %pa, i64 %la)|  %d2 = getelementptr i8, ptr %d, i64 %la|  %pb = call ptr @lep.tchars(i64 %b)|  %m2 = call ptr @memcpy(ptr %d2, ptr %pb, i64 %lb)|  ret i64 %t|}")
done()

(* the 256 single-byte Texts, interned so char_at/from_code never
   allocate - a lexer calls them once per source character *)
make cg_rt_chars(ctx)
    ensure q = text::from_code(34)
    ensure bs = text::from_code(92)
    ensure pad = bs + "00" + bs + "00" + bs + "00" + bs + "00" + bs + "00" + bs + "00" + bs + "00"
    suppose line = "@lep.chars = internal constant [256 x %lep.T1] ["
    suppose i = 0
    repeat
        when i > 255
            stop
        done()
        when i > 0
            line = line + ", "
        done()
        line = line + "%lep.T1 { i32 1, i32 0, i64 1, [8 x i8] c" + q + bs + cg_hex2(i) + pad + q + " }"
        i = i + 1
    done()
    cg_global(ctx, line + "], align 8")
done()

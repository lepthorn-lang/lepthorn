(* cg_rt_core.lep - the native runtime, part 1: written as LLVM IR by
   Lepthorn itself and emitted into every compiled program (no separate
   runtime library to install or link). Only libc/libm are called.

   Value word (i64): Number = IEEE bits + 2^49 (NaNs canonical),
   Boolean 6/7, "no value" 10, else a raw pointer to a heap object
   whose first i32 is its kind:
     1 Text   {kind, aux, len@8, bytes@16}
     2 Qty    {kind, aux, value@8 (double), dims@16 (8 x i32)}
     3 shape  {kind, shape id@4, nslots@8, slots@16}
     4 Array  {kind, aux, n@8, elems@16}
     5/6/7 Ring/Queue/Stack {kind, aux, cap@8, head@16, tail@24, count@32, buf@40}
     8 Handle {kind, fd@4 (i32), valid@8, mode@16 (Text)}
     9 Vector {kind, aux, x@8, y@16, z@24}
     10 Matrix {kind, aux, 9 doubles@8}

   Each rt() string is one or more IR lines, '|' separating lines. *)

use codegen::cg_core

make rt(ctx, s)
    ensure len = text::length(s)
    ensure nl = text::from_code(10)
    suppose outs = ""
    suppose seg = 0
    suppose i = 0
    repeat
        when i >= len
            stop
        done()
        when text::char_at(s, i) == "|"
            outs = outs + text::slice(s, seg, i) + nl
            seg = i + 1
        done()
        i = i + 1
    done()
    cg_global(ctx, outs + text::slice(s, seg, len))
done()

make rt_str(ctx, name, s)
    cg_cstr_global(ctx, "@.rt." + name, s)
done()

make cg_rt_header()
    ensure nl = text::from_code(10)
    ensure q = text::from_code(34)
    suppose h = "; generated by lepthornc" + nl + "source_filename = " + q + "lepthorn" + q + nl
    h = h + "%lep.T1 = type { i32, i32, i64, [8 x i8] }" + nl
    h = h + "%lep.U = type { ptr, double, [8 x i32] }" + nl
    h = h + "declare ptr @malloc(i64)" + nl + "declare ptr @calloc(i64, i64)" + nl + "declare ptr @realloc(ptr, i64)" + nl + "declare void @free(ptr)" + nl
    h = h + "declare ptr @memcpy(ptr, ptr, i64)" + nl + "declare ptr @memset(ptr, i32, i64)" + nl + "declare i32 @memcmp(ptr, ptr, i64)" + nl
    h = h + "declare i64 @strlen(ptr)" + nl + "declare i32 @strcmp(ptr, ptr)" + nl + "declare ptr @strcpy(ptr, ptr)" + nl + "declare ptr @strcat(ptr, ptr)" + nl
    h = h + "declare i32 @printf(ptr, ...)" + nl + "declare i32 @dprintf(i32, ptr, ...)" + nl + "declare i32 @snprintf(ptr, i64, ptr, ...)" + nl
    h = h + "declare i32 @fflush(ptr)" + nl + "declare i32 @putchar(i32)" + nl + "declare i64 @fwrite(ptr, i64, i64, ptr)" + nl + "declare i32 @setvbuf(ptr, ptr, i32, i64)" + nl
    h = h + "declare void @exit(i32)" + nl + "declare double @strtod(ptr, ptr)" + nl + "declare double @fmod(double, double)" + nl + "declare double @pow(double, double)" + nl + "declare double @cos(double)" + nl + "declare double @sin(double)" + nl
    h = h + "declare i32 @open(ptr, i32, ...)" + nl + "declare i64 @read(i32, ptr, i64)" + nl + "declare i64 @write(i32, ptr, i64)" + nl + "declare i32 @close(i32)" + nl + "declare i32 @unlink(ptr)" + nl + "declare i32 @stat(ptr, ptr)" + nl
    h = h + "declare ptr @__errno_location()" + nl + "declare i32 @system(ptr)" + nl + "declare i64 @readlink(ptr, ptr, i64)" + nl + "declare ptr @getcwd(ptr, i64)" + nl + "declare ptr @getenv(ptr)" + nl + "declare i32 @mkdir(ptr, i32)" + nl + "declare ptr @realpath(ptr, ptr)" + nl
    h = h + "declare i32 @clock_gettime(i32, ptr)" + nl + "declare i32 @nanosleep(ptr, ptr)" + nl + "declare i32 @getchar()" + nl + "declare i32 @isatty(i32)" + nl + "declare i32 @getrlimit(i32, ptr)" + nl + "declare i32 @setrlimit(i32, ptr)" + nl + "declare ptr @strstr(ptr, ptr)" + nl + "declare ptr @strchr(ptr, i32)" + nl + "declare double @llvm.fabs.f64(double)" + nl + "declare double @llvm.floor.f64(double)" + nl
    h = h + "declare i32 @fprintf(ptr, ptr, ...)" + nl + "declare i32 @fputc(i32, ptr)" + nl + "declare ptr @open_memstream(ptr, ptr)" + nl + "declare i32 @fclose(ptr)" + nl
    h = h + "declare i32 @chdir(ptr)" + nl + "declare i32 @setenv(ptr, ptr, i32)" + nl
    h = h + "declare ptr @popen(ptr, ptr)" + nl + "declare i32 @pclose(ptr)" + nl + "declare i64 @fread(ptr, i64, i64, ptr)" + nl
    h = h + "declare ptr @opendir(ptr)" + nl + "declare ptr @readdir(ptr)" + nl + "declare i32 @closedir(ptr)" + nl + "declare ptr @strdup(ptr)" + nl + "declare void @qsort(ptr, i64, i64, ptr)" + nl
    h = h + "@stdout = external global ptr" + nl
    done(h)
done()

make cg_rt_all(ctx)
    cg_rt_core(ctx)
    cg_rt_ops(ctx)
    cg_rt_data(ctx)
    cg_rt_text(ctx)
    cg_rt_show(ctx)
    cg_rt_io(ctx)
done()

make cg_rt_core(ctx)
    ensure nl = text::from_code(10)
    rt(ctx, "@lep.hp = internal global ptr null|@lep.he = internal global ptr null|@lep_depth = internal global i64 0|@lep.depth_limit = internal global i64 10000|@lep.ferr = internal global i64 0|@lep.argc = internal global i32 0|@lep.argv = internal global ptr null")
    rt(ctx, "@lep.dim0 = internal constant [8 x i32] zeroinitializer")
    cg_rt_chars(ctx)
    cg_rt_report(ctx)
    rt_error(ctx, "f_expect", "wrong_kind", ["%s", "%s", "%s"])
    rt_error_plain(ctx, "m_oom", "out_of_memory")
    rt_str(ctx, "kn_num", "Number")
    rt_str(ctx, "kn_bool", "Boolean")
    rt_str(ctx, "kn_nov", "no value")
    rt_str(ctx, "kn_text", "Text")
    rt_str(ctx, "kn_shape", "shape")
    rt_str(ctx, "kn_arr", "Array")
    (* an interpreter keeps the arrays of its program in shapes called
       TArray; errors call them by their real kind *)
    rt_str(ctx, "kn_tarr", "TArray")
    rt_str(ctx, "kn_ring", "RingBuffer")
    rt_str(ctx, "kn_queue", "Queue")
    rt_str(ctx, "kn_stack", "Stack")
    rt_str(ctx, "kn_handle", "Handle")
    rt_str(ctx, "kn_vec", "Vector")
    rt_str(ctx, "kn_mat", "Matrix")
    rt_str(ctx, "kn_unk", "unknown value")
    rt(ctx, "define internal i32 @lep.kind(i64 %v) alwaysinline {|entry:|  %lo = icmp uge i64 %v, 4096|  %hi = icmp ult i64 %v, 562949953421312|  %isobj = and i1 %lo, %hi|  br i1 %isobj, label %obj, label %none|obj:|  %p = inttoptr i64 %v to ptr|  %k = load i32, ptr %p|  ret i32 %k|none:|  ret i32 0|}")
    rt(ctx, "define internal i1 @lep.isnum(i64 %v) alwaysinline {|entry:|  %r = icmp uge i64 %v, 562949953421312|  ret i1 %r|}")
    rt(ctx, "define internal i1 @lep.isbool(i64 %v) {|entry:|  %a = icmp eq i64 %v, 6|  %b = icmp eq i64 %v, 7|  %r = or i1 %a, %b|  ret i1 %r|}")
    rt(ctx, "define internal double @lep.dec(i64 %v) alwaysinline {|entry:|  %b = sub i64 %v, 562949953421312|  %d = bitcast i64 %b to double|  ret double %d|}")
    rt(ctx, "define internal i64 @lep.enc(double %d) alwaysinline {|entry:|  %nan = fcmp uno double %d, %d|  %b = bitcast double %d to i64|  %c = select i1 %nan, i64 9221120237041090560, i64 %b|  %r = add i64 %c, 562949953421312|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep.num(i64 %n) {|entry:|  %d = sitofp i64 %n to double|  %r = call i64 @lep.enc(double %d)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep.bool(i1 %b) {|entry:|  %r = select i1 %b, i64 7, i64 6|  ret i64 %r|}")
    rt(ctx, "define internal ptr @lep.at(i64 %v, i64 %off) {|entry:|  %p = inttoptr i64 %v to ptr|  %q = getelementptr i8, ptr %p, i64 %off|  ret ptr %q|}")
    rt(ctx, "define internal i64 @lep.ld(i64 %v, i64 %off) {|entry:|  %q = call ptr @lep.at(i64 %v, i64 %off)|  %r = load i64, ptr %q|  ret i64 %r|}")
    rt(ctx, "define internal void @lep.st(i64 %v, i64 %off, i64 %x) {|entry:|  %q = call ptr @lep.at(i64 %v, i64 %off)|  store i64 %x, ptr %q|  ret void|}")
    rt(ctx, "define internal ptr @lep.alloc(i64 %n) {|entry:|  %n1 = add i64 %n, 15|  %n2 = and i64 %n1, -16|  %cur = load ptr, ptr @lep.hp|  %end = load ptr, ptr @lep.he|  %ci = ptrtoint ptr %cur to i64|  %ei = ptrtoint ptr %end to i64|  %room = sub i64 %ei, %ci|  %fits = icmp uge i64 %room, %n2|  %live = icmp ne ptr %cur, null|  %ok = and i1 %fits, %live|  br i1 %ok, label %fast, label %slow")
    rt(ctx, "slow:|  %big = icmp ugt i64 %n2, 67108864|  %sz = select i1 %big, i64 %n2, i64 67108864|  %blk = call ptr @malloc(i64 %sz)|  %null = icmp eq ptr %blk, null|  br i1 %null, label %oom, label %got|oom:|  call void @lep.die(ptr @.rt.m_oom)|  unreachable|got:|  %be = getelementptr i8, ptr %blk, i64 %sz|  store ptr %be, ptr @lep.he|  %nb = getelementptr i8, ptr %blk, i64 %n2|  store ptr %nb, ptr @lep.hp|  ret ptr %blk|fast:|  %nc = getelementptr i8, ptr %cur, i64 %n2|  store ptr %nc, ptr @lep.hp|  ret ptr %cur|}")
    rt(ctx, "define internal void @lep.die(ptr %msg) noinline cold {|entry:|  call void @lep.report(ptr %msg, i1 false)|  call void @exit(i32 1)|  unreachable|}")
    rt(ctx, "define internal void @lep.die1(ptr %fmt, ptr %a) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.die2(ptr %fmt, ptr %a, ptr %b) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a, ptr %b)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.die3(ptr %fmt, ptr %a, ptr %b, ptr %c) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a, ptr %b, ptr %c)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.diei(ptr %fmt, i64 %a) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, i64 %a)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.dieii(ptr %fmt, i64 %a, i64 %b) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, i64 %a, i64 %b)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.dieiii(ptr %fmt, i64 %a, i64 %b, i64 %c) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, i64 %a, i64 %b, i64 %c)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal void @lep.diesi(ptr %fmt, ptr %a, i64 %b) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, ptr %a, i64 %b)|  call void @lep.die(ptr %buf)|  unreachable|}")
    rt(ctx, "define internal ptr @lep.kname(i64 %v) {|entry:|  %isn = icmp uge i64 %v, 562949953421312|  br i1 %isn, label %k2, label %c1|c1:|  %b1 = icmp eq i64 %v, 6|  %b2 = icmp eq i64 %v, 7|  %bb = or i1 %b1, %b2|  br i1 %bb, label %kb, label %c2|kb:|  ret ptr @.rt.kn_bool|c2:|  %nv = icmp eq i64 %v, 10|  br i1 %nv, label %kn, label %c3|kn:|  ret ptr @.rt.kn_nov")
    rt(ctx, "c3:|  %k = call i32 @lep.kind(i64 %v)|  switch i32 %k, label %unk [ i32 1, label %k1 i32 2, label %k2 i32 3, label %k3 i32 4, label %k4 i32 5, label %k5 i32 6, label %k6 i32 7, label %k7 i32 8, label %k8 i32 9, label %k9 i32 10, label %k10 ]|k1:|  ret ptr @.rt.kn_text|k2:|  ret ptr @.rt.kn_num|k3:|  %sidp = call ptr @lep.at(i64 %v, i64 4)|  %sid = load i32, ptr %sidp|  %sn = call ptr @lep.shapename(i32 %sid)|  %cmp = call i32 @strcmp(ptr %sn, ptr @.rt.kn_tarr)|  %isarr = icmp eq i32 %cmp, 0|  %sk = select i1 %isarr, ptr @.rt.kn_arr, ptr @.rt.kn_shape|  ret ptr %sk|k4:|  ret ptr @.rt.kn_arr|k5:|  ret ptr @.rt.kn_ring|k6:|  ret ptr @.rt.kn_queue|k7:|  ret ptr @.rt.kn_stack|k8:|  ret ptr @.rt.kn_handle|k9:|  ret ptr @.rt.kn_vec|k10:|  ret ptr @.rt.kn_mat|unk:|  ret ptr @.rt.kn_unk|}")
    rt(ctx, "define internal void @lep.need(i64 %v, i32 %kind, ptr %fn, ptr %what) {|entry:|  %k = call i32 @lep.kind(i64 %v)|  %ok = icmp eq i32 %k, %kind|  br i1 %ok, label %good, label %bad|good:|  ret void|bad:|  %kn = call ptr @lep.kname(i64 %v)|  call void @lep.die3(ptr @.rt.f_expect, ptr %fn, ptr %what, ptr %kn)|  unreachable|}")
    rt(ctx, "define internal ptr @lep.tchars(i64 %v) {|entry:|  %p = call ptr @lep.at(i64 %v, i64 16)|  ret ptr %p|}")
    rt(ctx, "define internal i64 @lep.tlen(i64 %v) {|entry:|  %n = call i64 @lep.ld(i64 %v, i64 8)|  ret i64 %n|}")
    rt(ctx, "define internal i64 @lep.charv(i8 %b) {|entry:|  %bi = zext i8 %b to i64|  %cp = getelementptr [256 x %lep.T1], ptr @lep.chars, i64 0, i64 %bi|  %v = ptrtoint ptr %cp to i64|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep.text_alloc(i64 %len) {|entry:|  %sz = add i64 %len, 17|  %p = call ptr @lep.alloc(i64 %sz)|  store i32 1, ptr %p|  %ap = getelementptr i8, ptr %p, i64 4|  store i32 0, ptr %ap|  %lp = getelementptr i8, ptr %p, i64 8|  store i64 %len, ptr %lp|  %sp = getelementptr i8, ptr %p, i64 16|  %ep = getelementptr i8, ptr %sp, i64 %len|  store i8 0, ptr %ep|  %v = ptrtoint ptr %p to i64|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep.text_new(ptr %src, i64 %len) {|entry:|  %one = icmp eq i64 %len, 1|  br i1 %one, label %ch, label %gen|ch:|  %b = load i8, ptr %src|  %cv = call i64 @lep.charv(i8 %b)|  ret i64 %cv|gen:|  %t = call i64 @lep.text_alloc(i64 %len)|  %d = call ptr @lep.tchars(i64 %t)|  %m = call ptr @memcpy(ptr %d, ptr %src, i64 %len)|  ret i64 %t|}")
    rt(ctx, "define internal i64 @lep.cstr(ptr %s) {|entry:|  %n = call i64 @strlen(ptr %s)|  %t = call i64 @lep.text_new(ptr %s, i64 %n)|  ret i64 %t|}")
    rt(ctx, "define internal i32 @lep.tcmp(i64 %a, i64 %b) {|entry:|  %la = call i64 @lep.tlen(i64 %a)|  %lb = call i64 @lep.tlen(i64 %b)|  %lt = icmp ult i64 %la, %lb|  %m = select i1 %lt, i64 %la, i64 %lb|  %pa = call ptr @lep.tchars(i64 %a)|  %pb = call ptr @lep.tchars(i64 %b)|  %c = call i32 @memcmp(ptr %pa, ptr %pb, i64 %m)|  %z = icmp eq i32 %c, 0|  br i1 %z, label %bylen, label %sign|sign:|  %neg = icmp slt i32 %c, 0|  %s = select i1 %neg, i32 -1, i32 1|  ret i32 %s|bylen:|  %g = icmp ugt i64 %la, %lb|  %gi = zext i1 %g to i32|  %li = zext i1 %lt to i32|  %r = sub i32 %gi, %li|  ret i32 %r|}")
    rt(ctx, "define internal i64 @lep.concat(i64 %a, i64 %b) noinline {|entry:|  %la = call i64 @lep.tlen(i64 %a)|  %lb = call i64 @lep.tlen(i64 %b)|  %az = icmp eq i64 %la, 0|  br i1 %az, label %retb, label %c1|retb:|  ret i64 %b|c1:|  %bz = icmp eq i64 %lb, 0|  br i1 %bz, label %reta, label %go|reta:|  ret i64 %a|go:|  %n = add i64 %la, %lb|  %t = call i64 @lep.text_alloc(i64 %n)|  %d = call ptr @lep.tchars(i64 %t)|  %pa = call ptr @lep.tchars(i64 %a)|  %m1 = call ptr @memcpy(ptr %d, ptr %pa, i64 %la)|  %d2 = getelementptr i8, ptr %d, i64 %la|  %pb = call ptr @lep.tchars(i64 %b)|  %m2 = call ptr @memcpy(ptr %d2, ptr %pb, i64 %lb)|  ret i64 %t|}")
done()

(* the 256 single-byte Texts, interned so char_at/from_code never
   allocate - a lexer calls them once per source character *)
make cg_rt_chars(ctx)
    ensure q = text::from_code(34)
    ensure bs = text::from_code(92)
    ensure pad = bs + "00" + bs + "00" + bs + "00" + bs + "00" + bs + "00" + bs + "00" + bs + "00"
    suppose line = "@lep.chars = internal constant [256 x %lep.T1] ["
    suppose i = 0
    repeat
        when i > 255
            stop
        done()
        when i > 0
            line = line + ", "
        done()
        line = line + "%lep.T1 { i32 1, i32 0, i64 1, [8 x i8] c" + q + bs + cg_hex2(i) + pad + q + " }"
        i = i + 1
    done()
    cg_global(ctx, line + "], align 8")
done()

(* an error message for the run-time code, taken from src/core/errors/.
   Each {n} in the message becomes the printf format in `formats` (%s,
   %lld, ...), so a compiled program prints the same text as the
   interpreter. *)
make rt_error(ctx, key, name, formats)
    ensure entry = find_error(name)
    ensure why = fill_message(entry.message, formats)
    (* printf reads a % in this text as a format, so %% is written *)
    ensure fix = replace_all(entry.help, "%", "%%")
    rt_str(ctx, key, run_time_text(entry, why, fix, "while running"))
done()

make rt_error_plain(ctx, key, name)
    ensure entry = find_error(name)
    rt_str(ctx, key, run_time_text(entry, entry.message, entry.help, "while running"))
done()

(* a warning: the program goes on *)
make rt_warning(ctx, key, name, formats)
    ensure entry = find_error(name)
    ensure why = fill_message(entry.message, formats)
    rt_str(ctx, key, run_time_text(entry, why, entry.help, "warning"))
done()

(* How a compiled program shows an error. @lep.place is the spot where it
   is now; @lep.fixed_place is set by an interpreter instead (see
   sys::at_place). Colors only on a terminal, and not when NO_COLOR is
   set. A warning keeps the word after its code. *)
make cg_rt_report(ctx)
    ensure escape = text::from_code(27)
    ensure nl = text::from_code(10)
    ensure red = escape + "[31m"
    ensure off = escape + "[0m"
    rt_str(ctx, "e_where", "%.*s  ")
    rt_str(ctx, "e_file", "%s:%lld:%lld  ")
    rt_str(ctx, "e_line", "line %lld:%lld  ")
    rt_str(ctx, "e_code", "%.*s")
    rt_str(ctx, "e_red", red + "%.*s" + off)
    rt_str(ctx, "e_rest", "%s" + nl)
    rt_str(ctx, "e_green", "    " + escape + "[32mfix:" + off + "%s" + nl)
    rt_str(ctx, "e_before", nl + "    %.*s")
    rt_str(ctx, "e_thorn", "»%.*s«")
    rt_str(ctx, "e_thorn_red", red + "»%.*s«" + off)
    rt_str(ctx, "e_ascii", ">>%.*s<<")
    rt_str(ctx, "e_ascii_red", red + ">>%.*s<<" + off)
    rt_str(ctx, "e_after", "%s")
    rt_str(ctx, "e_gap", "  ")
    rt_str(ctx, "e_fix", "    fix:")
    rt_str(ctx, "e_nocolor", "NO_COLOR")
    rt(ctx, "@lep.place = internal global i32 0")
    rt(ctx, "define internal i1 @lep.colors() {|entry:|  %t = call i32 @isatty(i32 2)|  %tty = icmp ne i32 %t, 0|  %e = call ptr @getenv(ptr @.rt.e_nocolor)|  %none = icmp eq ptr %e, null|  br i1 %none, label %out, label %look|look:|  %c = load i8, ptr %e|  %empty = icmp eq i8 %c, 0|  %r = and i1 %tty, %empty|  ret i1 %r|out:|  ret i1 %tty|}")
    (* the length of the first line of a text, and the text after it *)
    rt(ctx, "define internal i32 @lep.linelen(ptr %s) {|entry:|  %nl = call ptr @strchr(ptr %s, i32 10)|  %none = icmp eq ptr %nl, null|  br i1 %none, label %all, label %part|all:|  %n = call i64 @strlen(ptr %s)|  %n32 = trunc i64 %n to i32|  ret i32 %n32|part:|  %a = ptrtoint ptr %nl to i64|  %b = ptrtoint ptr %s to i64|  %d = sub i64 %a, %b|  %d32 = trunc i64 %d to i32|  ret i32 %d32|}")
    rt(ctx, "define internal ptr @lep.nextline(ptr %s) {|entry:|  %n = call i32 @lep.linelen(ptr %s)|  %n64 = sext i32 %n to i64|  %i = add i64 %n64, 1|  %p = getelementptr i8, ptr %s, i64 %i|  ret ptr %p|}")
    (* the line of the program, with the wrong part between the thorns *)
    rt(ctx, "define internal void @lep.showline(i1 %col, i32 %bn, ptr %before, i32 %wn, ptr %wrong, ptr %after) noinline cold {|entry:|  %uni = call i1 @lep.uni()|  %f1 = select i1 %col, ptr @.rt.e_thorn_red, ptr @.rt.e_thorn|  %f2 = select i1 %col, ptr @.rt.e_ascii_red, ptr @.rt.e_ascii|  %f = select i1 %uni, ptr %f1, ptr %f2|  %w1 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_before, i32 %bn, ptr %before)|  %w2 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %f, i32 %wn, ptr %wrong)|  %w3 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_after, ptr %after)|  ret void|}")
    (* prints the place, and returns false when it is not known *)
    rt(ctx, "define internal i1 @lep.showplace(ptr %fixed) noinline cold {|entry:|  %hasf = icmp ne ptr %fixed, null|  br i1 %hasf, label %usefixed, label %own|usefixed:|  %n = call i32 @lep.linelen(ptr %fixed)|  %w0 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_where, i32 %n, ptr %fixed)|  ret i1 true|own:|  %s = load i32, ptr @lep.place|  %no = icmp eq i32 %s, 0|  br i1 %no, label %out, label %place|out:|  ret i1 false|place:|  %s64 = zext i32 %s to i64|  %wp = getelementptr i64, ptr @lep.spots, i64 %s64|  %w = load i64, ptr %wp|  %fi = lshr i64 %w, 40|  %l0 = lshr i64 %w, 16|  %ln = and i64 %l0, 16777215|  %cl = and i64 %w, 65535|  %fp = getelementptr ptr, ptr @lep.files, i64 %fi|  %fn = load ptr, ptr %fp|  %f0 = load i8, ptr %fn|  %nf = icmp eq i8 %f0, 0|  br i1 %nf, label %line, label %file|line:|  %w1 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_line, i64 %ln, i64 %cl)|  ret i1 true|file:|  %w2 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_file, ptr %fn, i64 %ln, i64 %cl)|  ret i1 true|}")
    rt(ctx, "define internal void @lep.showspot(ptr %fixed, i1 %col) noinline cold {|entry:|  %hasf = icmp ne ptr %fixed, null|  br i1 %hasf, label %usefixed, label %own|usefixed:|  %b = call ptr @lep.nextline(ptr %fixed)|  %bn = call i32 @lep.linelen(ptr %b)|  %wr = call ptr @lep.nextline(ptr %b)|  %wn = call i32 @lep.linelen(ptr %wr)|  %af = call ptr @lep.nextline(ptr %wr)|  call void @lep.showline(i1 %col, i32 %bn, ptr %b, i32 %wn, ptr %wr, ptr %af)|  ret void|own:|  %has = load i1, ptr @lep.has_lines|  br i1 %has, label %lines, label %out|lines:|  %s = load i32, ptr @lep.place|  %s64 = zext i32 %s to i64|  %lp = getelementptr ptr, ptr @lep.spot_lines, i64 %s64|  %l = load ptr, ptr %lp|  %pp = getelementptr i32, ptr @lep.spot_parts, i64 %s64|  %pt = load i32, ptr %pp|  %first = lshr i32 %pt, 16|  %len = and i32 %pt, 65535|  %f64 = zext i32 %first to i64|  %w = getelementptr i8, ptr %l, i64 %f64|  %n64 = zext i32 %len to i64|  %a = getelementptr i8, ptr %w, i64 %n64|  call void @lep.showline(i1 %col, i32 %first, ptr %l, i32 %len, ptr %w, ptr %a)|  ret void|out:|  ret void|}")
    (* the message is CODE, two spaces, a word, and then lines *)
    rt(ctx, "define internal void @lep.report(ptr %msg, i1 %keep) noinline cold {|entry:|  %fl = call i32 @fflush(ptr null)|  %col = call i1 @lep.colors()|  %fixed = load ptr, ptr @lep.fixed_place|  %known = call i1 @lep.showplace(ptr %fixed)|  %gap = call ptr @strstr(ptr %msg, ptr @.rt.e_gap)|  %nogap = icmp eq ptr %gap, null|  br i1 %nogap, label %raw, label %code|raw:|  %w0 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_rest, ptr %msg)|  ret void|code:|  %gi = ptrtoint ptr %gap to i64|  %mi = ptrtoint ptr %msg to i64|  %cl = sub i64 %gi, %mi|  %cn = trunc i64 %cl to i32|  %cf = select i1 %col, ptr @.rt.e_red, ptr @.rt.e_code|  %w3 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %cf, i32 %cn, ptr %msg)|  %hn = call i32 @lep.linelen(ptr %gap)|  %h64 = sext i32 %hn to i64|  %rest = getelementptr i8, ptr %gap, i64 %h64|  %unk = xor i1 %known, true|  %word = or i1 %unk, %keep|  br i1 %word, label %words, label %line|words:|  %w4 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_code, i32 %hn, ptr %gap)|  br label %line|line:|  br i1 %known, label %shown, label %text|shown:|  call void @lep.showspot(ptr %fixed, i1 %col)|  br label %text|text:|  br i1 %col, label %tryfix, label %plain|tryfix:|  %fx = call ptr @strstr(ptr %rest, ptr @.rt.e_fix)|  %hasfix = icmp ne ptr %fx, null|  br i1 %hasfix, label %green, label %plain|green:|  %xi = ptrtoint ptr %fx to i64|  %ri = ptrtoint ptr %rest to i64|  %bl = sub i64 %xi, %ri|  %bln = trunc i64 %bl to i32|  %w5 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_code, i32 %bln, ptr %rest)|  %aft = getelementptr i8, ptr %fx, i64 8|  %w6 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_green, ptr %aft)|  ret void|plain:|  %w7 = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.rt.e_rest, ptr %rest)|  ret void|}")
    (* a warning with one or two times in it; the program goes on *)
    rt(ctx, "define internal void @lep.warn2(ptr %fmt, double %a, double %b) noinline cold {|entry:|  %buf = alloca [2048 x i8]|  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 2048, ptr %fmt, double %a, double %b)|  call void @lep.report(ptr %buf, i1 true)|  ret void|}")
done()

(* cg_rt_show.lep - the native runtime, part 5: `show` formatting and
   the call-time checks. Numbers print as %.6g (the host's format); a
   dimensioned number is followed by its unit, SI style: kg·m/s² (N),
   or kg*m/s^2 (N) when LEPTHORN_OUTPUT=ascii. The mode is read at each
   use, so sys::setenv can change it. Compound values print the way the
   host's Value.to_string does. *)

use codegen::cg_core
use codegen::cg_rt_core

make cg_rt_show(ctx)
    rt_str(ctx, "f_g6", "%.6g")
    rt_str(ctx, "s_true", "true")
    rt_str(ctx, "s_false", "false")
    rt_str(ctx, "m_noval", "show: this value was never assigned")
    rt_str(ctx, "m_unkval", "show: unknown value")
    rt_str(ctx, "f_sp_s", " %s")
    rt_str(ctx, "f_s_lp", "%s(")
    rt_str(ctx, "s_comma", ", ")
    rt_str(ctx, "f_s_eq", "%s = ")
    rt_str(ctx, "f_ring", "RingBuffer[%lld/%lld]")
    rt_str(ctx, "f_queue", "Queue[%lld/%lld]")
    rt_str(ctx, "f_stack", "Stack[%lld/%lld]")
    rt_str(ctx, "f_handle", "Handle(%s, %s)")
    rt_str(ctx, "s_open", "open")
    rt_str(ctx, "s_closed", "closed")
    rt_str(ctx, "f_mat", "[[%.6g, %.6g, %.6g], [%.6g, %.6g, %.6g], [%.6g, %.6g, %.6g]]")
    rt_str(ctx, "f_depth", "%s: maximum recursion depth (10000) exceeded")
    rt_str(ctx, "f_novalue", "%s: this function never reaches done(value) - it cannot be used as a value (call it as a bare statement instead)")
    cg_rt_dimtables(ctx)
    rt(ctx, "define internal void @lep.put(ptr %f, i64 %v) {|entry:|  %ip = alloca i64|  %buf = alloca [512 x i8]|  %isn = call i1 @lep.isnum(i64 %v)|  br i1 %isn, label %num, label %c1|num:|  %d = call double @lep.dec(i64 %v)|  %w0 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_g6, double %d)|  ret void|c1:|  %t = icmp eq i64 %v, 7|  br i1 %t, label %tru, label %c2|tru:|  %w1 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.s_true)|  ret void|c2:|  %isf = icmp eq i64 %v, 6|  br i1 %isf, label %fal, label %c3|fal:|  %w2 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.s_false)|  ret void|c3:|  %nv = icmp eq i64 %v, 10|  br i1 %nv, label %noval, label %c4|noval:|  call void @lep.die(ptr @.rt.m_noval)|  unreachable")
    rt(ctx, "c4:|  %k = call i32 @lep.kind(i64 %v)|  switch i32 %k, label %unk [ i32 1, label %txt i32 2, label %qty i32 3, label %shp i32 4, label %arr i32 5, label %ring i32 6, label %queue i32 7, label %stack i32 8, label %hdl i32 9, label %vec i32 10, label %mat ]|txt:|  %tp = call ptr @lep.tchars(i64 %v)|  %tl = call i64 @lep.tlen(i64 %v)|  %fw = call i64 @fwrite(ptr %tp, i64 1, i64 %tl, ptr %f)|  ret void|qty:|  %qp = call ptr @lep.at(i64 %v, i64 8)|  %qv = load double, ptr %qp|  %w3 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_g6, double %qv)|  br label %qsuf|qsuf:|  %dp = call ptr @lep.at(i64 %v, i64 16)|  call void @lep.dimsuffix(ptr %dp, ptr %buf)|  %b0 = load i8, ptr %buf|  %has = icmp ne i8 %b0, 0|  br i1 %has, label %qprint, label %qret|qprint:|  %w4 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_sp_s, ptr %buf)|  br label %qret|qret:|  ret void")
    rt(ctx, "shp:|  %sidp = call ptr @lep.at(i64 %v, i64 4)|  %sid32 = load i32, ptr %sidp|  %sn = call ptr @lep.shapename(i32 %sid32)|  %w5 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_s_lp, ptr %sn)|  %nslots = call i64 @lep.ld(i64 %v, i64 8)|  %sid = sext i32 %sid32 to i64|  %offp = getelementptr i32, ptr @lep.slot_off, i64 %sid|  %off32 = load i32, ptr %offp|  %off = sext i32 %off32 to i64|  store i64 0, ptr %ip|  br label %sl|sl:|  %i = load i64, ptr %ip|  %sdone = icmp sge i64 %i, %nslots|  br i1 %sdone, label %send, label %sb|sb:|  %sfirst = icmp eq i64 %i, 0|  br i1 %sfirst, label %sb1, label %scomma|scomma:|  %w6 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.s_comma)|  br label %sb1|sb1:|  %fi = add i64 %off, %i|  %fidp = getelementptr i32, ptr @lep.slot_fids, i64 %fi|  %fid32 = load i32, ptr %fidp|  %fid = sext i32 %fid32 to i64|  %fnm = call ptr @lep.fieldname(i64 %fid)|  %w7 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_s_eq, ptr %fnm)|  %so1 = mul i64 %i, 8|  %so2 = add i64 %so1, 16|  %fv = call i64 @lep.ld(i64 %v, i64 %so2)|  call void @lep.put(ptr %f, i64 %fv)|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %sl|send:|  %w8 = call i32 @fputc(i32 41, ptr %f)|  ret void")
    rt(ctx, "arr:|  %w9 = call i32 @fputc(i32 91, ptr %f)|  %an = call i64 @lep.ld(i64 %v, i64 8)|  store i64 0, ptr %ip|  br label %al|al:|  %j = load i64, ptr %ip|  %adone = icmp sge i64 %j, %an|  br i1 %adone, label %aend, label %ab|ab:|  %afirst = icmp eq i64 %j, 0|  br i1 %afirst, label %ab1, label %acomma|acomma:|  %w10 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.s_comma)|  br label %ab1|ab1:|  %ao1 = mul i64 %j, 8|  %ao2 = add i64 %ao1, 16|  %ev = call i64 @lep.ld(i64 %v, i64 %ao2)|  call void @lep.put(ptr %f, i64 %ev)|  %j1 = add i64 %j, 1|  store i64 %j1, ptr %ip|  br label %al|aend:|  %w11 = call i32 @fputc(i32 93, ptr %f)|  ret void")
    rt(ctx, "ring:|  %rc = call i64 @lep.ld(i64 %v, i64 32)|  %rcap = call i64 @lep.ld(i64 %v, i64 8)|  %w12 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_ring, i64 %rc, i64 %rcap)|  ret void|queue:|  %qc = call i64 @lep.ld(i64 %v, i64 32)|  %qcap = call i64 @lep.ld(i64 %v, i64 8)|  %w13 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_queue, i64 %qc, i64 %qcap)|  ret void|stack:|  %sc = call i64 @lep.ld(i64 %v, i64 32)|  %scap = call i64 @lep.ld(i64 %v, i64 8)|  %w14 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_stack, i64 %sc, i64 %scap)|  ret void|hdl:|  %mode = call i64 @lep.ld(i64 %v, i64 16)|  %mp = call ptr @lep.tchars(i64 %mode)|  %valid = call i64 @lep.ld(i64 %v, i64 8)|  %isopen = icmp ne i64 %valid, 0|  %st = select i1 %isopen, ptr @.rt.s_open, ptr @.rt.s_closed|  %w15 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_handle, ptr %mp, ptr %st)|  ret void")
    rt(ctx, "vec:|  %w16 = call i32 @fputc(i32 40, ptr %f)|  %vx = call i64 @lep.ld(i64 %v, i64 8)|  call void @lep.put(ptr %f, i64 %vx)|  %w17 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.s_comma)|  %vy = call i64 @lep.ld(i64 %v, i64 16)|  call void @lep.put(ptr %f, i64 %vy)|  %w18 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.s_comma)|  %vz = call i64 @lep.ld(i64 %v, i64 24)|  call void @lep.put(ptr %f, i64 %vz)|  %w19 = call i32 @fputc(i32 41, ptr %f)|  ret void|mat:|  %mb = call ptr @lep.at(i64 %v, i64 8)|  %mp0 = getelementptr double, ptr %mb, i64 0|  %m0 = load double, ptr %mp0|  %mp1 = getelementptr double, ptr %mb, i64 1|  %m1 = load double, ptr %mp1|  %mp2 = getelementptr double, ptr %mb, i64 2|  %m2 = load double, ptr %mp2|  %mp3 = getelementptr double, ptr %mb, i64 3|  %m3 = load double, ptr %mp3|  %mp4 = getelementptr double, ptr %mb, i64 4|  %m4 = load double, ptr %mp4|  %mp5 = getelementptr double, ptr %mb, i64 5|  %m5 = load double, ptr %mp5|  %mp6 = getelementptr double, ptr %mb, i64 6|  %m6 = load double, ptr %mp6|  %mp7 = getelementptr double, ptr %mb, i64 7|  %m7 = load double, ptr %mp7|  %mp8 = getelementptr double, ptr %mb, i64 8|  %m8 = load double, ptr %mp8|  %w20 = call i32 (ptr, ptr, ...) @fprintf(ptr %f, ptr @.rt.f_mat, double %m0, double %m1, double %m2, double %m3, double %m4, double %m5, double %m6, double %m7, double %m8)|  ret void|unk:|  call void @lep.die(ptr @.rt.m_unkval)|  unreachable|}")
    rt(ctx, "define internal void @lep_show1(i64 %v) {|entry:|  %so = load ptr, ptr @stdout|  call void @lep.put(ptr %so, i64 %v)|  %c = call i32 @fputc(i32 10, ptr %so)|  ret void|}")
    rt(ctx, "define internal void @lep_show_arg(i64 %v, i64 %first) {|entry:|  %so = load ptr, ptr @stdout|  %isfirst = icmp ne i64 %first, 0|  br i1 %isfirst, label %go, label %sp|sp:|  %c = call i32 @fputc(i32 32, ptr %so)|  br label %go|go:|  call void @lep.put(ptr %so, i64 %v)|  ret void|}")
    rt(ctx, "define internal void @lep_show_end() {|entry:|  %so = load ptr, ptr @stdout|  %c = call i32 @fputc(i32 10, ptr %so)|  ret void|}")
    rt(ctx, "define internal void @lep_depth_fail(i64 %f) {|entry:|  %p = call ptr @lep.tchars(i64 %f)|  call void @lep.die1(ptr @.rt.f_depth, ptr %p)|  unreachable|}")
    rt(ctx, "define internal i64 @lep_need_value(i64 %r, i64 %f) {|entry:|  %nv = icmp eq i64 %r, 10|  br i1 %nv, label %bad, label %ok|ok:|  ret i64 %r|bad:|  %p = call ptr @lep.tchars(i64 %f)|  call void @lep.die1(ptr @.rt.f_novalue, ptr %p)|  unreachable|}")
    rt(ctx, "define internal i1 @lep.uni() {|entry:|  %e = call ptr @getenv(ptr @.rt.s_outenv)|  %null = icmp eq ptr %e, null|  br i1 %null, label %yes, label %chk|chk:|  %c = call i32 @strcmp(ptr %e, ptr @.rt.s_ascii)|  %is = icmp eq i32 %c, 0|  br i1 %is, label %no, label %yes|yes:|  ret i1 true|no:|  ret i1 false|}")
    rt(ctx, "define internal void @lep.dimsuffix(ptr %d, ptr %out) {|entry:|  %comp = alloca [1536 x i8]|  store i8 0, ptr %out|  %z = call i1 @lep.dimz(ptr %d)|  br i1 %z, label %done, label %go|go:|  %uni = call i1 @lep.uni()|  call void @lep.dimcomp(ptr %d, ptr %comp, i1 %uni)|  %nm = call ptr @lep.dimnamed(ptr %d)|  %n0 = load i8, ptr %nm|  %empty = icmp eq i8 %n0, 0|  br i1 %empty, label %onlycomp, label %c2|onlycomp:|  %s1 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %out, i64 512, ptr @.rt.f_pcts, ptr %comp)|  br label %done|c2:|  %cmp = call i32 @strcmp(ptr %nm, ptr %comp)|  %same = icmp eq i32 %cmp, 0|  br i1 %same, label %onlyname, label %both|onlyname:|  %s2 = call ptr @strcpy(ptr %out, ptr %nm)|  br label %done|both:|  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %out, i64 512, ptr @.rt.f_both, ptr %comp, ptr %nm)|  br label %done|done:|  ret void|}")
    (* numerator/denominator, the denominator in parentheses when it has
       more than one unit (kg/(m·s²), not the ambiguous kg/m·s²); with no
       numerator, negative exponents (s⁻¹) *)
    rt(ctx, "define internal void @lep.dimcomp(ptr %d, ptr %out, i1 %uni) {|entry:|  %num = alloca [512 x i8]|  %den = alloca [512 x i8]|  %ip = alloca i64|  %ndp = alloca i64|  store i8 0, ptr %num|  store i8 0, ptr %den|  store i64 0, ptr %ip|  store i64 0, ptr %ndp|  br label %loop|loop:|  %i = load i64, ptr %ip|  %dn = icmp sge i64 %i, 8|  br i1 %dn, label %fin, label %body|body:|  %ep = getelementptr i32, ptr %d, i64 %i|  %e = load i32, ptr %ep|  %symp = getelementptr ptr, ptr @lep.dimsyms, i64 %i|  %sym = load ptr, ptr %symp|  %pos = icmp sgt i32 %e, 0|  br i1 %pos, label %addnum, label %chkneg|addnum:|  call void @lep.dimterm(ptr %num, ptr %sym, i32 %e, i1 %uni)|  br label %next|chkneg:|  %neg = icmp slt i32 %e, 0|  br i1 %neg, label %addden, label %next|addden:|  %ne = sub i32 0, %e|  call void @lep.dimterm(ptr %den, ptr %sym, i32 %ne, i1 %uni)|  %nd = load i64, ptr %ndp|  %nd1 = add i64 %nd, 1|  store i64 %nd1, ptr %ndp|  br label %next|next:|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop")
    rt(ctx, "fin:|  %n0 = load i8, ptr %num|  %nz = icmp eq i8 %n0, 0|  %ndt = load i64, ptr %ndp|  br i1 %nz, label %nonum, label %hasnum|nonum:|  %dz = icmp eq i64 %ndt, 0|  br i1 %dz, label %dimless, label %inv|dimless:|  %c1 = call ptr @strcpy(ptr %out, ptr @.rt.s_dimless)|  ret void|inv:|  store i8 0, ptr %out|  store i64 0, ptr %ip|  br label %iloop|iloop:|  %j = load i64, ptr %ip|  %jd = icmp sge i64 %j, 8|  br i1 %jd, label %idone, label %ibody|ibody:|  %ep2 = getelementptr i32, ptr %d, i64 %j|  %e2 = load i32, ptr %ep2|  %neg2 = icmp slt i32 %e2, 0|  br i1 %neg2, label %iadd, label %inext|iadd:|  %symp2 = getelementptr ptr, ptr @lep.dimsyms, i64 %j|  %sym2 = load ptr, ptr %symp2|  call void @lep.dimterm(ptr %out, ptr %sym2, i32 %e2, i1 %uni)|  br label %inext|inext:|  %j1 = add i64 %j, 1|  store i64 %j1, ptr %ip|  br label %iloop|idone:|  ret void|hasnum:|  %c4 = call ptr @strcpy(ptr %out, ptr %num)|  %dz2 = icmp eq i64 %ndt, 0|  br i1 %dz2, label %done, label %withden|withden:|  %c5 = call ptr @strcat(ptr %out, ptr @.rt.s_slash)|  %multi = icmp sgt i64 %ndt, 1|  br i1 %multi, label %paren, label %single|paren:|  %c6 = call ptr @strcat(ptr %out, ptr @.rt.s_lparen)|  %c7 = call ptr @strcat(ptr %out, ptr %den)|  %c8 = call ptr @strcat(ptr %out, ptr @.rt.s_rparen)|  br label %done|single:|  %c9 = call ptr @strcat(ptr %out, ptr %den)|  br label %done|done:|  ret void|}")
    rt(ctx, "define internal void @lep.dimterm(ptr %buf, ptr %sym, i32 %e, i1 %uni) {|entry:|  %b0 = load i8, ptr %buf|  %nonempty = icmp ne i8 %b0, 0|  br i1 %nonempty, label %sep, label %add|sep:|  %sp = select i1 %uni, ptr @.rt.u_dot, ptr @.rt.s_star|  %c0 = call ptr @strcat(ptr %buf, ptr %sp)|  br label %add|add:|  %c1 = call ptr @strcat(ptr %buf, ptr %sym)|  %one = icmp eq i32 %e, 1|  br i1 %one, label %done, label %power|power:|  call void @lep.expo(ptr %buf, i32 %e, i1 %uni)|  br label %done|done:|  ret void|}")
    rt(ctx, "define internal void @lep.expo(ptr %buf, i32 %e, i1 %uni) {|entry:|  %digits = alloca [16 x i8]|  %ip = alloca i64|  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %digits, i64 16, ptr @.rt.f_int, i32 %e)|  br i1 %uni, label %sup, label %ascii|ascii:|  %c0 = call ptr @strcat(ptr %buf, ptr @.rt.s_caret)|  %c1 = call ptr @strcat(ptr %buf, ptr %digits)|  ret void|sup:|  store i64 0, ptr %ip|  br label %loop|loop:|  %i = load i64, ptr %ip|  %cp = getelementptr i8, ptr %digits, i64 %i|  %ch = load i8, ptr %cp|  %end = icmp eq i8 %ch, 0|  br i1 %end, label %done, label %body|body:|  %minus = icmp eq i8 %ch, 45|  br i1 %minus, label %m, label %dg|m:|  %c2 = call ptr @strcat(ptr %buf, ptr @.rt.u_minus)|  br label %next|dg:|  %dv = sub i8 %ch, 48|  %dz = zext i8 %dv to i64|  %gp = getelementptr ptr, ptr @lep.supdigits, i64 %dz|  %g = load ptr, ptr %gp|  %c3 = call ptr @strcat(ptr %buf, ptr %g)|  br label %next|next:|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|done:|  ret void|}")
    rt(ctx, "define internal ptr @lep.dimnamed(ptr %d) {|entry:|  %ip = alloca i64|  store i64 0, ptr %ip|  br label %loop|loop:|  %i = load i64, ptr %ip|  %dn = icmp sge i64 %i, 9|  br i1 %dn, label %none, label %body|body:|  %row = getelementptr [8 x i32], ptr @lep.dimtab, i64 %i|  %eq = call i1 @lep.dimeq(ptr %d, ptr %row)|  br i1 %eq, label %hit, label %next|hit:|  %np = getelementptr ptr, ptr @lep.dimtabn, i64 %i|  %n = load ptr, ptr %np|  ret ptr %n|next:|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|none:|  ret ptr @.rt.s_empty|}")
done()

(* base-dimension symbols in order, the Unicode pieces, and the nine
   named dimensions *)
make cg_rt_dimtables(ctx)
    rt_str(ctx, "d_kg", "kg")
    rt_str(ctx, "d_m", "m")
    rt_str(ctx, "d_s", "s")
    rt_str(ctx, "d_A", "A")
    rt_str(ctx, "d_K", "K")
    rt_str(ctx, "d_mol", "mol")
    rt_str(ctx, "d_cd", "cd")
    rt_str(ctx, "d_rad", "rad")
    rt_str(ctx, "s_empty", "")
    rt_str(ctx, "f_pcts", "%s")
    rt_str(ctx, "f_int", "%d")
    rt_str(ctx, "s_lparen", "(")
    rt_str(ctx, "s_rparen", ")")
    rt_str(ctx, "s_outenv", "LEPTHORN_OUTPUT")
    rt_str(ctx, "s_ascii", "ascii")
    rt_str(ctx, "u_dot", "·")
    rt_str(ctx, "u_minus", "⁻")
    rt_str(ctx, "u0", "⁰")
    rt_str(ctx, "u1", "¹")
    rt_str(ctx, "u2", "²")
    rt_str(ctx, "u3", "³")
    rt_str(ctx, "u4", "⁴")
    rt_str(ctx, "u5", "⁵")
    rt_str(ctx, "u6", "⁶")
    rt_str(ctx, "u7", "⁷")
    rt_str(ctx, "u8", "⁸")
    rt_str(ctx, "u9", "⁹")
    rt_str(ctx, "f_both", "%s (%s)")
    rt_str(ctx, "s_dimless", "dimensionless")
    rt_str(ctx, "s_oneslash", "1/")
    rt_str(ctx, "s_slash", "/")
    rt_str(ctx, "s_star", "*")
    rt_str(ctx, "s_caret", "^")
    rt_str(ctx, "n_N", "N")
    rt_str(ctx, "n_J", "J")
    rt_str(ctx, "n_Pa", "Pa")
    rt_str(ctx, "n_W", "W")
    rt_str(ctx, "n_Hz", "Hz")
    rt(ctx, "@lep.dimsyms = internal constant [8 x ptr] [ptr @.rt.d_kg, ptr @.rt.d_m, ptr @.rt.d_s, ptr @.rt.d_A, ptr @.rt.d_K, ptr @.rt.d_mol, ptr @.rt.d_cd, ptr @.rt.d_rad]")
    rt(ctx, "@lep.supdigits = internal constant [10 x ptr] [ptr @.rt.u0, ptr @.rt.u1, ptr @.rt.u2, ptr @.rt.u3, ptr @.rt.u4, ptr @.rt.u5, ptr @.rt.u6, ptr @.rt.u7, ptr @.rt.u8, ptr @.rt.u9]")
    rt(ctx, "@lep.dimtab = internal constant [9 x [8 x i32]] [[8 x i32] [i32 1, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 0, i32 1, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 0, i32 0, i32 1, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 1], [8 x i32] [i32 1, i32 1, i32 -2, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 1, i32 2, i32 -2, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 1, i32 -1, i32 -2, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 1, i32 2, i32 -3, i32 0, i32 0, i32 0, i32 0, i32 0], [8 x i32] [i32 0, i32 0, i32 -1, i32 0, i32 0, i32 0, i32 0, i32 0]]")
    rt(ctx, "@lep.dimtabn = internal constant [9 x ptr] [ptr @.rt.d_kg, ptr @.rt.d_m, ptr @.rt.d_s, ptr @.rt.d_rad, ptr @.rt.n_N, ptr @.rt.n_J, ptr @.rt.n_Pa, ptr @.rt.n_W, ptr @.rt.n_Hz]")
done()


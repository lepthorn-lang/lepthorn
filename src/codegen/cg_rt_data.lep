(* cg_rt_data.lep - the native runtime, part 3: shapes (field access by
   a program-wide field id through @lep.layout, emitted per program by
   cg_program), arrays, and the RingBuffer/Queue/Stack collections with
   the host's exact full/empty/out-of-range semantics. *)

use codegen::cg_core
use codegen::cg_rt_core

make cg_rt_data(ctx)
    rt_str(ctx, "f_notshape", "field '%s': expected a shape value, got %s")
    rt_str(ctx, "f_nofield", "%s: no field '%s'")
    rt_str(ctx, "fn_index", "array indexing")
    rt_str(ctx, "fn_length", "length")
    rt_str(ctx, "w_array", "an Array")
    rt_str(ctx, "m_badindex", "an array index must be a dimensionless Number")
    rt_str(ctx, "f_oob", "LEC8013: index %lld is out of bounds for an array of length %lld")
    rt_str(ctx, "f_cap", "%s: capacity must be a positive whole Number, got %lld")
    rt(ctx, "define internal ptr @lep.shapename(i32 %sid) {|entry:|  %s = sext i32 %sid to i64|  %p = getelementptr ptr, ptr @lep.shape_names, i64 %s|  %n = load ptr, ptr %p|  ret ptr %n|}")
    rt(ctx, "define internal ptr @lep.fieldname(i64 %fid) {|entry:|  %p = getelementptr ptr, ptr @lep.field_names, i64 %fid|  %n = load ptr, ptr %p|  ret ptr %n|}")
    rt(ctx, "define internal i64 @lep_shape_new(i64 %sid) {|entry:|  %ip = alloca i64|  %np = getelementptr i32, ptr @lep.shape_nslots, i64 %sid|  %n32 = load i32, ptr %np|  %n = sext i32 %n32 to i64|  %bytes = mul i64 %n, 8|  %sz = add i64 %bytes, 16|  %p = call ptr @lep.alloc(i64 %sz)|  store i32 3, ptr %p|  %ap = getelementptr i8, ptr %p, i64 4|  %s32 = trunc i64 %sid to i32|  store i32 %s32, ptr %ap|  %lp = getelementptr i8, ptr %p, i64 8|  store i64 %n, ptr %lp|  store i64 0, ptr %ip|  br label %loop|loop:|  %i = load i64, ptr %ip|  %done = icmp sge i64 %i, %n|  br i1 %done, label %out, label %body|body:|  %o = mul i64 %i, 8|  %o2 = add i64 %o, 16|  %fp = getelementptr i8, ptr %p, i64 %o2|  store i64 10, ptr %fp|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|out:|  %v = ptrtoint ptr %p to i64|  ret i64 %v|}")
    rt(ctx, "define internal void @lep_shape_init(i64 %s, i64 %slot, i64 %x) {|entry:|  %o = mul i64 %slot, 8|  %o2 = add i64 %o, 16|  call void @lep.st(i64 %s, i64 %o2, i64 %x)|  ret void|}")
    rt(ctx, "define internal ptr @lep.fieldref(i64 %o, i64 %fid) {|entry:|  %k = call i32 @lep.kind(i64 %o)|  %iss = icmp eq i32 %k, 3|  br i1 %iss, label %ok, label %bad|bad:|  %fn = call ptr @lep.fieldname(i64 %fid)|  %kn = call ptr @lep.kname(i64 %o)|  call void @lep.die2(ptr @.rt.f_notshape, ptr %fn, ptr %kn)|  unreachable|ok:|  %ap = call ptr @lep.at(i64 %o, i64 4)|  %sid32 = load i32, ptr %ap|  %sid = sext i32 %sid32 to i64|  %nf = load i64, ptr @lep.nfids|  %base = mul i64 %sid, %nf|  %ix = add i64 %base, %fid|  %lp = getelementptr i32, ptr @lep.layout, i64 %ix|  %slot32 = load i32, ptr %lp|  %neg = icmp slt i32 %slot32, 0|  br i1 %neg, label %nofield, label %found|nofield:|  %sn = call ptr @lep.shapename(i32 %sid32)|  %fn2 = call ptr @lep.fieldname(i64 %fid)|  call void @lep.die2(ptr @.rt.f_nofield, ptr %sn, ptr %fn2)|  unreachable|found:|  %slot = sext i32 %slot32 to i64|  %o1 = mul i64 %slot, 8|  %o2 = add i64 %o1, 16|  %fp = call ptr @lep.at(i64 %o, i64 %o2)|  ret ptr %fp|}")
    rt(ctx, "define internal i64 @lep_get_field(i64 %o, i64 %fid) {|entry:|  %p = call ptr @lep.fieldref(i64 %o, i64 %fid)|  %v = load i64, ptr %p|  ret i64 %v|}")
    rt(ctx, "define internal void @lep_set_field(i64 %o, i64 %fid, i64 %x) {|entry:|  %p = call ptr @lep.fieldref(i64 %o, i64 %fid)|  store i64 %x, ptr %p|  ret void|}")
    rt(ctx, "define internal i64 @lep_array_new(i64 %n) {|entry:|  %bytes = mul i64 %n, 8|  %sz = add i64 %bytes, 16|  %p = call ptr @lep.alloc(i64 %sz)|  store i32 4, ptr %p|  %ap = getelementptr i8, ptr %p, i64 4|  store i32 0, ptr %ap|  %lp = getelementptr i8, ptr %p, i64 8|  store i64 %n, ptr %lp|  %v = ptrtoint ptr %p to i64|  ret i64 %v|}")
    rt(ctx, "define internal void @lep_array_init(i64 %a, i64 %i, i64 %x) {|entry:|  %o = mul i64 %i, 8|  %o2 = add i64 %o, 16|  call void @lep.st(i64 %a, i64 %o2, i64 %x)|  ret void|}")
    rt(ctx, "define internal ptr @lep.elemref(i64 %a, i64 %idx) {|entry:|  call void @lep.need(i64 %a, i32 4, ptr @.rt.fn_index, ptr @.rt.w_array)|  %isn = call i1 @lep.isnum(i64 %idx)|  br i1 %isn, label %ok, label %badi|badi:|  call void @lep.die(ptr @.rt.m_badindex)|  unreachable|ok:|  %d = call double @lep.dec(i64 %idx)|  %i = fptosi double %d to i64|  %n = call i64 @lep.ld(i64 %a, i64 8)|  %lo = icmp slt i64 %i, 0|  %hi = icmp sge i64 %i, %n|  %oob = or i1 %lo, %hi|  br i1 %oob, label %bad, label %good|bad:|  call void @lep.dieii(ptr @.rt.f_oob, i64 %i, i64 %n)|  unreachable|good:|  %o = mul i64 %i, 8|  %o2 = add i64 %o, 16|  %p = call ptr @lep.at(i64 %a, i64 %o2)|  ret ptr %p|}")
    rt(ctx, "define internal i64 @lep_index_get(i64 %a, i64 %idx) {|entry:|  %p = call ptr @lep.elemref(i64 %a, i64 %idx)|  %v = load i64, ptr %p|  ret i64 %v|}")
    rt(ctx, "define internal void @lep_index_set(i64 %a, i64 %idx, i64 %x) {|entry:|  %p = call ptr @lep.elemref(i64 %a, i64 %idx)|  store i64 %x, ptr %p|  ret void|}")
    rt(ctx, "define internal i64 @lep_length(i64 %a) {|entry:|  call void @lep.need(i64 %a, i32 4, ptr @.rt.fn_length, ptr @.rt.w_array)|  %n = call i64 @lep.ld(i64 %a, i64 8)|  %r = call i64 @lep.num(i64 %n)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep.coll_new(i32 %kind, i64 %capv, ptr %fn) {|entry:|  %cap = call i64 @lep.whole(i64 %capv, ptr %fn)|  %pos = icmp sgt i64 %cap, 0|  br i1 %pos, label %ok, label %bad|bad:|  call void @lep.diesi(ptr @.rt.f_cap, ptr %fn, i64 %cap)|  unreachable|ok:|  %p = call ptr @lep.alloc(i64 48)|  store i32 %kind, ptr %p|  %ap = getelementptr i8, ptr %p, i64 4|  store i32 0, ptr %ap|  %v = ptrtoint ptr %p to i64|  call void @lep.st(i64 %v, i64 8, i64 %cap)|  call void @lep.st(i64 %v, i64 16, i64 0)|  call void @lep.st(i64 %v, i64 24, i64 0)|  call void @lep.st(i64 %v, i64 32, i64 0)|  %buf = call ptr @calloc(i64 %cap, i64 8)|  %null = icmp eq ptr %buf, null|  br i1 %null, label %oom, label %done|oom:|  call void @lep.die(ptr @.rt.m_oom)|  unreachable|done:|  %bp = getelementptr i8, ptr %p, i64 40|  store ptr %buf, ptr %bp|  ret i64 %v|}")
    rt(ctx, "define internal ptr @lep.cslot(i64 %c, i64 %i) {|entry:|  %bp = call ptr @lep.at(i64 %c, i64 40)|  %buf = load ptr, ptr %bp|  %sp = getelementptr i64, ptr %buf, i64 %i|  ret ptr %sp|}")
    cg_rt_ring(ctx)
    cg_rt_queue(ctx)
    cg_rt_stack(ctx)
done()

(* size/is_empty/is_full are identical for all three kinds apart from
   the kind tag and the names in error messages *)
make cg_rt_coll_common(ctx, ns, kind, noun)
    rt_str(ctx, "fn_" + ns + "_size", ns + "::size")
    rt_str(ctx, "fn_" + ns + "_is_empty", ns + "::is_empty")
    rt_str(ctx, "fn_" + ns + "_is_full", ns + "::is_full")
    rt_str(ctx, "fn_" + ns + "_create", ns + "::create")
    rt_str(ctx, "w_" + ns, noun)
    rt(ctx, "define internal i64 @lep_" + ns + "_create(i64 %c) {|entry:|  %r = call i64 @lep.coll_new(i32 " + kind + ", i64 %c, ptr @.rt.fn_" + ns + "_create)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep_" + ns + "_size(i64 %c) {|entry:|  call void @lep.need(i64 %c, i32 " + kind + ", ptr @.rt.fn_" + ns + "_size, ptr @.rt.w_" + ns + ")|  %n = call i64 @lep.ld(i64 %c, i64 32)|  %r = call i64 @lep.num(i64 %n)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep_" + ns + "_is_empty(i64 %c) {|entry:|  call void @lep.need(i64 %c, i32 " + kind + ", ptr @.rt.fn_" + ns + "_is_empty, ptr @.rt.w_" + ns + ")|  %n = call i64 @lep.ld(i64 %c, i64 32)|  %e = icmp eq i64 %n, 0|  %r = select i1 %e, i64 7, i64 6|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep_" + ns + "_is_full(i64 %c) {|entry:|  call void @lep.need(i64 %c, i32 " + kind + ", ptr @.rt.fn_" + ns + "_is_full, ptr @.rt.w_" + ns + ")|  %n = call i64 @lep.ld(i64 %c, i64 32)|  %cap = call i64 @lep.ld(i64 %c, i64 8)|  %e = icmp eq i64 %n, %cap|  %r = select i1 %e, i64 7, i64 6|  ret i64 %r|}")
done()

make cg_rt_ring(ctx)
    cg_rt_coll_common(ctx, "ring", "5", "a RingBuffer")
    rt_str(ctx, "fn_ring_write", "ring::write")
    rt_str(ctx, "fn_ring_get", "ring::get")
    rt_str(ctx, "fn_ring_peek", "ring::peek")
    rt_str(ctx, "fn_ring_clear", "ring::clear")
    rt_str(ctx, "m_ring_empty", "LEC8015: ring::get: RingBuffer is empty")
    rt_str(ctx, "w_peekidx", "ring::peek: the index")
    rt_str(ctx, "f_peek", "ring::peek: index %lld is out of bounds for a RingBuffer holding %lld element(s)")
    rt(ctx, "define internal i64 @lep_ring_write(i64 %r, i64 %x) {|entry:|  call void @lep.need(i64 %r, i32 5, ptr @.rt.fn_ring_write, ptr @.rt.w_ring)|  %cap = call i64 @lep.ld(i64 %r, i64 8)|  %head = call i64 @lep.ld(i64 %r, i64 16)|  %tail = call i64 @lep.ld(i64 %r, i64 24)|  %cnt = call i64 @lep.ld(i64 %r, i64 32)|  %sp = call ptr @lep.cslot(i64 %r, i64 %tail)|  store i64 %x, ptr %sp|  %full = icmp eq i64 %cnt, %cap|  br i1 %full, label %f, label %nf|f:|  %h1 = add i64 %head, 1|  %h2 = urem i64 %h1, %cap|  call void @lep.st(i64 %r, i64 16, i64 %h2)|  br label %tl|nf:|  %c1 = add i64 %cnt, 1|  call void @lep.st(i64 %r, i64 32, i64 %c1)|  br label %tl|tl:|  %t1 = add i64 %tail, 1|  %t2 = urem i64 %t1, %cap|  call void @lep.st(i64 %r, i64 24, i64 %t2)|  ret i64 7|}")
    rt(ctx, "define internal i64 @lep_ring_get(i64 %r) {|entry:|  call void @lep.need(i64 %r, i32 5, ptr @.rt.fn_ring_get, ptr @.rt.w_ring)|  %cnt = call i64 @lep.ld(i64 %r, i64 32)|  %e = icmp eq i64 %cnt, 0|  br i1 %e, label %empty, label %ok|empty:|  call void @lep.die(ptr @.rt.m_ring_empty)|  unreachable|ok:|  %cap = call i64 @lep.ld(i64 %r, i64 8)|  %head = call i64 @lep.ld(i64 %r, i64 16)|  %sp = call ptr @lep.cslot(i64 %r, i64 %head)|  %x = load i64, ptr %sp|  %h1 = add i64 %head, 1|  %h2 = urem i64 %h1, %cap|  call void @lep.st(i64 %r, i64 16, i64 %h2)|  %c1 = sub i64 %cnt, 1|  call void @lep.st(i64 %r, i64 32, i64 %c1)|  ret i64 %x|}")
    rt(ctx, "define internal i64 @lep_ring_peek(i64 %r, i64 %iv) {|entry:|  call void @lep.need(i64 %r, i32 5, ptr @.rt.fn_ring_peek, ptr @.rt.w_ring)|  %i = call i64 @lep.whole(i64 %iv, ptr @.rt.w_peekidx)|  %cnt = call i64 @lep.ld(i64 %r, i64 32)|  %lo = icmp slt i64 %i, 0|  %hi = icmp sge i64 %i, %cnt|  %oob = or i1 %lo, %hi|  br i1 %oob, label %bad, label %ok|bad:|  call void @lep.dieii(ptr @.rt.f_peek, i64 %i, i64 %cnt)|  unreachable|ok:|  %cap = call i64 @lep.ld(i64 %r, i64 8)|  %head = call i64 @lep.ld(i64 %r, i64 16)|  %s = add i64 %head, %i|  %m = urem i64 %s, %cap|  %sp = call ptr @lep.cslot(i64 %r, i64 %m)|  %x = load i64, ptr %sp|  ret i64 %x|}")
    rt(ctx, "define internal i64 @lep_ring_clear(i64 %r) {|entry:|  call void @lep.need(i64 %r, i32 5, ptr @.rt.fn_ring_clear, ptr @.rt.w_ring)|  call void @lep.st(i64 %r, i64 16, i64 0)|  call void @lep.st(i64 %r, i64 24, i64 0)|  call void @lep.st(i64 %r, i64 32, i64 0)|  ret i64 7|}")
done()

make cg_rt_queue(ctx)
    cg_rt_coll_common(ctx, "queue", "6", "a Queue")
    rt_str(ctx, "fn_queue_enqueue", "queue::enqueue")
    rt_str(ctx, "fn_queue_dequeue", "queue::dequeue")
    rt_str(ctx, "fn_queue_front", "queue::front")
    rt_str(ctx, "m_queue_full", "LEC8014: queue::enqueue: Queue is full")
    rt_str(ctx, "m_queue_empty_dq", "LEC8015: queue::dequeue: Queue is empty")
    rt_str(ctx, "m_queue_empty_fr", "LEC8015: queue::front: Queue is empty")
    rt(ctx, "define internal i64 @lep_queue_enqueue(i64 %q, i64 %x) {|entry:|  call void @lep.need(i64 %q, i32 6, ptr @.rt.fn_queue_enqueue, ptr @.rt.w_queue)|  %cap = call i64 @lep.ld(i64 %q, i64 8)|  %cnt = call i64 @lep.ld(i64 %q, i64 32)|  %full = icmp eq i64 %cnt, %cap|  br i1 %full, label %bad, label %ok|bad:|  call void @lep.die(ptr @.rt.m_queue_full)|  unreachable|ok:|  %tail = call i64 @lep.ld(i64 %q, i64 24)|  %sp = call ptr @lep.cslot(i64 %q, i64 %tail)|  store i64 %x, ptr %sp|  %t1 = add i64 %tail, 1|  %t2 = urem i64 %t1, %cap|  call void @lep.st(i64 %q, i64 24, i64 %t2)|  %c1 = add i64 %cnt, 1|  call void @lep.st(i64 %q, i64 32, i64 %c1)|  ret i64 7|}")
    rt(ctx, "define internal i64 @lep_queue_dequeue(i64 %q) {|entry:|  call void @lep.need(i64 %q, i32 6, ptr @.rt.fn_queue_dequeue, ptr @.rt.w_queue)|  %cnt = call i64 @lep.ld(i64 %q, i64 32)|  %e = icmp eq i64 %cnt, 0|  br i1 %e, label %bad, label %ok|bad:|  call void @lep.die(ptr @.rt.m_queue_empty_dq)|  unreachable|ok:|  %cap = call i64 @lep.ld(i64 %q, i64 8)|  %head = call i64 @lep.ld(i64 %q, i64 16)|  %sp = call ptr @lep.cslot(i64 %q, i64 %head)|  %x = load i64, ptr %sp|  %h1 = add i64 %head, 1|  %h2 = urem i64 %h1, %cap|  call void @lep.st(i64 %q, i64 16, i64 %h2)|  %c1 = sub i64 %cnt, 1|  call void @lep.st(i64 %q, i64 32, i64 %c1)|  ret i64 %x|}")
    rt(ctx, "define internal i64 @lep_queue_front(i64 %q) {|entry:|  call void @lep.need(i64 %q, i32 6, ptr @.rt.fn_queue_front, ptr @.rt.w_queue)|  %cnt = call i64 @lep.ld(i64 %q, i64 32)|  %e = icmp eq i64 %cnt, 0|  br i1 %e, label %bad, label %ok|bad:|  call void @lep.die(ptr @.rt.m_queue_empty_fr)|  unreachable|ok:|  %head = call i64 @lep.ld(i64 %q, i64 16)|  %sp = call ptr @lep.cslot(i64 %q, i64 %head)|  %x = load i64, ptr %sp|  ret i64 %x|}")
done()

make cg_rt_stack(ctx)
    cg_rt_coll_common(ctx, "stack", "7", "a Stack")
    rt_str(ctx, "fn_stack_push", "stack::push")
    rt_str(ctx, "fn_stack_pop", "stack::pop")
    rt_str(ctx, "fn_stack_peek", "stack::peek")
    rt_str(ctx, "m_stack_full", "LEC8014: stack::push: Stack is full")
    rt_str(ctx, "m_stack_empty_pop", "LEC8015: stack::pop: Stack is empty")
    rt_str(ctx, "m_stack_empty_peek", "LEC8015: stack::peek: Stack is empty")
    rt(ctx, "define internal i64 @lep_stack_push(i64 %s, i64 %x) {|entry:|  call void @lep.need(i64 %s, i32 7, ptr @.rt.fn_stack_push, ptr @.rt.w_stack)|  %cap = call i64 @lep.ld(i64 %s, i64 8)|  %cnt = call i64 @lep.ld(i64 %s, i64 32)|  %full = icmp eq i64 %cnt, %cap|  br i1 %full, label %bad, label %ok|bad:|  call void @lep.die(ptr @.rt.m_stack_full)|  unreachable|ok:|  %sp = call ptr @lep.cslot(i64 %s, i64 %cnt)|  store i64 %x, ptr %sp|  %c1 = add i64 %cnt, 1|  call void @lep.st(i64 %s, i64 32, i64 %c1)|  ret i64 7|}")
    rt(ctx, "define internal i64 @lep_stack_pop(i64 %s) {|entry:|  call void @lep.need(i64 %s, i32 7, ptr @.rt.fn_stack_pop, ptr @.rt.w_stack)|  %cnt = call i64 @lep.ld(i64 %s, i64 32)|  %e = icmp eq i64 %cnt, 0|  br i1 %e, label %bad, label %ok|bad:|  call void @lep.die(ptr @.rt.m_stack_empty_pop)|  unreachable|ok:|  %c1 = sub i64 %cnt, 1|  call void @lep.st(i64 %s, i64 32, i64 %c1)|  %sp = call ptr @lep.cslot(i64 %s, i64 %c1)|  %x = load i64, ptr %sp|  ret i64 %x|}")
    rt(ctx, "define internal i64 @lep_stack_peek(i64 %s) {|entry:|  call void @lep.need(i64 %s, i32 7, ptr @.rt.fn_stack_peek, ptr @.rt.w_stack)|  %cnt = call i64 @lep.ld(i64 %s, i64 32)|  %e = icmp eq i64 %cnt, 0|  br i1 %e, label %bad, label %ok|bad:|  call void @lep.die(ptr @.rt.m_stack_empty_peek)|  unreachable|ok:|  %c1 = sub i64 %cnt, 1|  %sp = call ptr @lep.cslot(i64 %s, i64 %c1)|  %x = load i64, ptr %sp|  ret i64 %x|}")
done()

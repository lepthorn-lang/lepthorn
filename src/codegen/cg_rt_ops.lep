(* cg_rt_ops.lep - the native runtime, part 2: quantities, arithmetic,
   equality/ordering, Boolean logic. Dimensionless Number pairs take an
   inline fast path; anything else goes through @lep.arith. Dimension
   rules follow the bootstrap interpreter (a mismatch prints LEC8025 and
   yields 0; == across dimensions is false). *)

use codegen::cg_core
use codegen::cg_rt_core

make cg_rt_ops(ctx)
    ensure nl = text::from_code(10)
    rt_str(ctx, "op_add", "+")
    rt_str(ctx, "op_sub", "-")
    rt_str(ctx, "op_mul", "*")
    rt_str(ctx, "op_div", "/")
    rt_str(ctx, "op_mod", "%")
    rt_str(ctx, "op_pow", "**")
    rt_str(ctx, "op_lt", "<")
    rt_str(ctx, "op_gt", ">")
    rt_str(ctx, "op_le", "<=")
    rt_str(ctx, "op_ge", ">=")
    rt_str(ctx, "f_needq", "`%s` requires both operands to be quantities, got %s and %s")
    rt_str(ctx, "m_divz", "Division by zero")
    rt_str(ctx, "m_modz", "Modulo by zero")
    rt_str(ctx, "m_powdim", "LEC8027: runtime error: exponent must be dimensionless" + nl)
    rt_str(ctx, "m_powfrac", "`**`: a dimensioned base requires a whole-number exponent (fractional powers of a physical dimension are not defined)")
    rt_str(ctx, "f_dimwarn", "LEC8025: runtime error: dimension mismatch in %s" + nl)
    rt_str(ctx, "f_eqkind", "`==` requires both operands to be the same kind of value (both quantities of the same dimension, both Text, both Boolean, or both the same shape), got %s and %s")
    rt_str(ctx, "f_eqshape", "`==` requires both operands to be the same shape; got %s and %s")
    rt_str(ctx, "f_needord", "`%s` requires both operands to be quantities or both Text, got %s and %s")
    rt_str(ctx, "m_and", "`and` requires both operands to be Boolean")
    rt_str(ctx, "m_or", "`or` requires both operands to be Boolean")
    rt_str(ctx, "m_not", "`not` requires a Boolean operand")
    rt_str(ctx, "f_cond", "`%s` condition must be Boolean, got %s")
    rt_str(ctx, "cn_when", "when")
    rt_str(ctx, "cn_until", "until")
    rt_str(ctx, "cn_wait", "wait")
    rt_str(ctx, "f_whole", "%s must be a dimensionless Number, got %s")
    rt_str(ctx, "w_repeat", "`repeat`: the count")
    rt(ctx, "define internal i1 @lep.getq(i64 %v, ptr %pv, ptr %pd) {|entry:|  %isn = call i1 @lep.isnum(i64 %v)|  br i1 %isn, label %num, label %c1|num:|  %d = call double @lep.dec(i64 %v)|  store double %d, ptr %pv|  %z = call ptr @memset(ptr %pd, i32 0, i64 32)|  ret i1 true|c1:|  %k = call i32 @lep.kind(i64 %v)|  %isq = icmp eq i32 %k, 2|  br i1 %isq, label %qty, label %no|qty:|  %vp = call ptr @lep.at(i64 %v, i64 8)|  %x = load double, ptr %vp|  store double %x, ptr %pv|  %dp = call ptr @lep.at(i64 %v, i64 16)|  %m = call ptr @memcpy(ptr %pd, ptr %dp, i64 32)|  ret i1 true|no:|  ret i1 false|}")
    rt(ctx, "define internal i1 @lep.dimeq(ptr %a, ptr %b) {|entry:|  %c = call i32 @memcmp(ptr %a, ptr %b, i64 32)|  %r = icmp eq i32 %c, 0|  ret i1 %r|}")
    rt(ctx, "define internal i1 @lep.dimz(ptr %a) {|entry:|  %r = call i1 @lep.dimeq(ptr %a, ptr @lep.dim0)|  ret i1 %r|}")
    rt(ctx, "define internal i64 @lep.mkq(double %x, ptr %d) {|entry:|  %z = call i1 @lep.dimz(ptr %d)|  br i1 %z, label %plain, label %box|plain:|  %r = call i64 @lep.enc(double %x)|  ret i64 %r|box:|  %p = call ptr @lep.alloc(i64 48)|  store i32 2, ptr %p|  %ap = getelementptr i8, ptr %p, i64 4|  store i32 0, ptr %ap|  %vp = getelementptr i8, ptr %p, i64 8|  store double %x, ptr %vp|  %dp = getelementptr i8, ptr %p, i64 16|  %m = call ptr @memcpy(ptr %dp, ptr %d, i64 32)|  %v = ptrtoint ptr %p to i64|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep_qty(double %x, i32 %d0, i32 %d1, i32 %d2, i32 %d3, i32 %d4, i32 %d5, i32 %d6, i32 %d7) {|entry:|  %d = alloca [8 x i32]|  %p0 = getelementptr i32, ptr %d, i64 0|  store i32 %d0, ptr %p0|  %p1 = getelementptr i32, ptr %d, i64 1|  store i32 %d1, ptr %p1|  %p2 = getelementptr i32, ptr %d, i64 2|  store i32 %d2, ptr %p2|  %p3 = getelementptr i32, ptr %d, i64 3|  store i32 %d3, ptr %p3|  %p4 = getelementptr i32, ptr %d, i64 4|  store i32 %d4, ptr %p4|  %p5 = getelementptr i32, ptr %d, i64 5|  store i32 %d5, ptr %p5|  %p6 = getelementptr i32, ptr %d, i64 6|  store i32 %d6, ptr %p6|  %p7 = getelementptr i32, ptr %d, i64 7|  store i32 %d7, ptr %p7|  %r = call i64 @lep.mkq(double %x, ptr %d)|  ret i64 %r|}")
    rt(ctx, "define internal void @lep.dimop(ptr %r, ptr %p, ptr %q, i32 %sg) {|entry:|  %ip = alloca i64|  store i64 0, ptr %ip|  br label %loop|loop:|  %i = load i64, ptr %ip|  %done = icmp sge i64 %i, 8|  br i1 %done, label %out, label %body|body:|  %pp = getelementptr i32, ptr %p, i64 %i|  %qp = getelementptr i32, ptr %q, i64 %i|  %rp = getelementptr i32, ptr %r, i64 %i|  %a = load i32, ptr %pp|  %b = load i32, ptr %qp|  %m = mul i32 %b, %sg|  %s = add i32 %a, %m|  store i32 %s, ptr %rp|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|out:|  ret void|}")
    rt(ctx, "define internal void @lep.dimscale(ptr %r, ptr %p, i32 %n) {|entry:|  %ip = alloca i64|  store i64 0, ptr %ip|  br label %loop|loop:|  %i = load i64, ptr %ip|  %done = icmp sge i64 %i, 8|  br i1 %done, label %out, label %body|body:|  %pp = getelementptr i32, ptr %p, i64 %i|  %rp = getelementptr i32, ptr %r, i64 %i|  %a = load i32, ptr %pp|  %s = mul i32 %a, %n|  store i32 %s, ptr %rp|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|out:|  ret void|}")
    rt(ctx, "define internal ptr @lep.opname(i32 %op) {|entry:|  switch i32 %op, label %o0 [ i32 1, label %o1 i32 2, label %o2 i32 3, label %o3 i32 4, label %o4 i32 5, label %o5 ]|o0:|  ret ptr @.rt.op_add|o1:|  ret ptr @.rt.op_sub|o2:|  ret ptr @.rt.op_mul|o3:|  ret ptr @.rt.op_div|o4:|  ret ptr @.rt.op_mod|o5:|  ret ptr @.rt.op_pow|}")
    rt(ctx, "define internal i64 @lep.arith(i64 %a, i64 %b, i32 %op) {|entry:|  %pv = alloca double|  %qv = alloca double|  %pd = alloca [8 x i32]|  %qd = alloca [8 x i32]|  %rd = alloca [8 x i32]|  %g1 = call i1 @lep.getq(i64 %a, ptr %pv, ptr %pd)|  %g2 = call i1 @lep.getq(i64 %b, ptr %qv, ptr %qd)|  %g = and i1 %g1, %g2|  br i1 %g, label %ok, label %bad|bad:|  %on = call ptr @lep.opname(i32 %op)|  %kna = call ptr @lep.kname(i64 %a)|  %knb = call ptr @lep.kname(i64 %b)|  call void @lep.die3(ptr @.rt.f_needq, ptr %on, ptr %kna, ptr %knb)|  unreachable")
    rt(ctx, "ok:|  %x = load double, ptr %pv|  %y = load double, ptr %qv|  switch i32 %op, label %padd [ i32 1, label %psub i32 2, label %pmul i32 3, label %pdiv i32 4, label %pmod i32 5, label %ppow ]|padd:|  %e0 = call i1 @lep.dimeq(ptr %pd, ptr %qd)|  br i1 %e0, label %padd2, label %mism|padd2:|  %s0 = fadd double %x, %y|  %r0 = call i64 @lep.mkq(double %s0, ptr %pd)|  ret i64 %r0|psub:|  %e1 = call i1 @lep.dimeq(ptr %pd, ptr %qd)|  br i1 %e1, label %psub2, label %mism|psub2:|  %s1 = fsub double %x, %y|  %r1 = call i64 @lep.mkq(double %s1, ptr %pd)|  ret i64 %r1|pmul:|  call void @lep.dimop(ptr %rd, ptr %pd, ptr %qd, i32 1)|  %s2 = fmul double %x, %y|  %r2 = call i64 @lep.mkq(double %s2, ptr %rd)|  ret i64 %r2")
    rt(ctx, "pdiv:|  %z3 = fcmp oeq double %y, 0.0|  br i1 %z3, label %divz, label %pdiv2|divz:|  call void @lep.die(ptr @.rt.m_divz)|  unreachable|pdiv2:|  call void @lep.dimop(ptr %rd, ptr %pd, ptr %qd, i32 -1)|  %s3 = fdiv double %x, %y|  %r3 = call i64 @lep.mkq(double %s3, ptr %rd)|  ret i64 %r3|pmod:|  %z4 = fcmp oeq double %y, 0.0|  br i1 %z4, label %modz, label %pmod1|modz:|  call void @lep.die(ptr @.rt.m_modz)|  unreachable|pmod1:|  %e4 = call i1 @lep.dimeq(ptr %pd, ptr %qd)|  br i1 %e4, label %pmod2, label %mism|pmod2:|  %s4 = call double @fmod(double %x, double %y)|  %r4 = call i64 @lep.mkq(double %s4, ptr %pd)|  ret i64 %r4")
    rt(ctx, "ppow:|  %qz = call i1 @lep.dimz(ptr %qd)|  br i1 %qz, label %ppow1, label %powbad|powbad:|  %pw = call i32 (ptr, ...) @printf(ptr @.rt.m_powdim)|  %zz = call i64 @lep.enc(double 0.0)|  ret i64 %zz|ppow1:|  %pz = call i1 @lep.dimz(ptr %pd)|  br i1 %pz, label %plain, label %pdim|plain:|  %s5 = call double @pow(double %x, double %y)|  %r5 = call i64 @lep.enc(double %s5)|  ret i64 %r5|pdim:|  %fr = call double @fmod(double %y, double 1.0)|  %whole = fcmp oeq double %fr, 0.0|  br i1 %whole, label %pdim2, label %pfrac|pfrac:|  call void @lep.die(ptr @.rt.m_powfrac)|  unreachable|pdim2:|  %n = fptosi double %y to i32|  call void @lep.dimscale(ptr %rd, ptr %pd, i32 %n)|  %s6 = call double @pow(double %x, double %y)|  %r6 = call i64 @lep.mkq(double %s6, ptr %rd)|  ret i64 %r6|mism:|  %on2 = call ptr @lep.opname(i32 %op)|  %wm = call i32 (ptr, ...) @printf(ptr @.rt.f_dimwarn, ptr %on2)|  %zr = call i64 @lep.enc(double 0.0)|  ret i64 %zr|}")
    rt(ctx, "define internal i64 @lep_add(i64 %a, i64 %b) {|entry:|  %an = call i1 @lep.isnum(i64 %a)|  %bn = call i1 @lep.isnum(i64 %b)|  %nn = and i1 %an, %bn|  br i1 %nn, label %fast, label %slow|fast:|  %x = call double @lep.dec(i64 %a)|  %y = call double @lep.dec(i64 %b)|  %s = fadd double %x, %y|  %r = call i64 @lep.enc(double %s)|  ret i64 %r|slow:|  %ka = call i32 @lep.kind(i64 %a)|  %kb = call i32 @lep.kind(i64 %b)|  %ta = icmp eq i32 %ka, 1|  %tb = icmp eq i32 %kb, 1|  %tt = and i1 %ta, %tb|  br i1 %tt, label %cat, label %ar|cat:|  %c = call i64 @lep.concat(i64 %a, i64 %b)|  ret i64 %c|ar:|  %r2 = call i64 @lep.arith(i64 %a, i64 %b, i32 0)|  ret i64 %r2|}")
    rt(ctx, "define internal i64 @lep_sub(i64 %a, i64 %b) {|entry:|  %an = call i1 @lep.isnum(i64 %a)|  %bn = call i1 @lep.isnum(i64 %b)|  %nn = and i1 %an, %bn|  br i1 %nn, label %fast, label %slow|fast:|  %x = call double @lep.dec(i64 %a)|  %y = call double @lep.dec(i64 %b)|  %s = fsub double %x, %y|  %r = call i64 @lep.enc(double %s)|  ret i64 %r|slow:|  %r2 = call i64 @lep.arith(i64 %a, i64 %b, i32 1)|  ret i64 %r2|}")
    rt(ctx, "define internal i64 @lep_mul(i64 %a, i64 %b) {|entry:|  %an = call i1 @lep.isnum(i64 %a)|  %bn = call i1 @lep.isnum(i64 %b)|  %nn = and i1 %an, %bn|  br i1 %nn, label %fast, label %slow|fast:|  %x = call double @lep.dec(i64 %a)|  %y = call double @lep.dec(i64 %b)|  %s = fmul double %x, %y|  %r = call i64 @lep.enc(double %s)|  ret i64 %r|slow:|  %r2 = call i64 @lep.arith(i64 %a, i64 %b, i32 2)|  ret i64 %r2|}")
    rt(ctx, "define internal i64 @lep_div(i64 %a, i64 %b) {|entry:|  %r = call i64 @lep.arith(i64 %a, i64 %b, i32 3)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep_mod(i64 %a, i64 %b) {|entry:|  %r = call i64 @lep.arith(i64 %a, i64 %b, i32 4)|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep_pow(i64 %a, i64 %b) {|entry:|  %r = call i64 @lep.arith(i64 %a, i64 %b, i32 5)|  ret i64 %r|}")
    rt(ctx, "define internal i1 @lep.veq(i64 %a, i64 %b) {|entry:|  %pv = alloca double|  %qv = alloca double|  %pd = alloca [8 x i32]|  %qd = alloca [8 x i32]|  %an = call i1 @lep.isnum(i64 %a)|  %bn = call i1 @lep.isnum(i64 %b)|  %nn = and i1 %an, %bn|  br i1 %nn, label %nums, label %c1|nums:|  %x = call double @lep.dec(i64 %a)|  %y = call double @lep.dec(i64 %b)|  %e = fcmp oeq double %x, %y|  ret i1 %e|c1:|  %g1 = call i1 @lep.getq(i64 %a, ptr %pv, ptr %pd)|  %g2 = call i1 @lep.getq(i64 %b, ptr %qv, ptr %qd)|  %g = and i1 %g1, %g2|  br i1 %g, label %qq, label %c2|qq:|  %de = call i1 @lep.dimeq(ptr %pd, ptr %qd)|  br i1 %de, label %qq2, label %no|qq2:|  %x2 = load double, ptr %pv|  %y2 = load double, ptr %qv|  %e2 = fcmp oeq double %x2, %y2|  ret i1 %e2|no:|  ret i1 false")
    rt(ctx, "c2:|  %ka = call i32 @lep.kind(i64 %a)|  %kb = call i32 @lep.kind(i64 %b)|  %ta = icmp eq i32 %ka, 1|  %tb = icmp eq i32 %kb, 1|  %tt = and i1 %ta, %tb|  br i1 %tt, label %txt, label %c3|txt:|  %c = call i32 @lep.tcmp(i64 %a, i64 %b)|  %e3 = icmp eq i32 %c, 0|  ret i1 %e3|c3:|  %ba = call i1 @lep.isbool(i64 %a)|  %bb = call i1 @lep.isbool(i64 %b)|  %both = and i1 %ba, %bb|  br i1 %both, label %bools, label %c4|bools:|  %e4 = icmp eq i64 %a, %b|  ret i1 %e4|c4:|  %sa = icmp eq i32 %ka, 3|  %sb = icmp eq i32 %kb, 3|  %ss = and i1 %sa, %sb|  br i1 %ss, label %shp, label %bad|shp:|  %e5 = call i1 @lep.shape_eq(i64 %a, i64 %b)|  ret i1 %e5|bad:|  %kna = call ptr @lep.kname(i64 %a)|  %knb = call ptr @lep.kname(i64 %b)|  call void @lep.die2(ptr @.rt.f_eqkind, ptr %kna, ptr %knb)|  unreachable|}")
    rt(ctx, "define internal i1 @lep.shape_eq(i64 %a, i64 %b) {|entry:|  %ip = alloca i64|  %ap = call ptr @lep.at(i64 %a, i64 4)|  %sa = load i32, ptr %ap|  %bp = call ptr @lep.at(i64 %b, i64 4)|  %sb = load i32, ptr %bp|  %same = icmp eq i32 %sa, %sb|  br i1 %same, label %go, label %bad|bad:|  %na = call ptr @lep.shapename(i32 %sa)|  %nb = call ptr @lep.shapename(i32 %sb)|  call void @lep.die2(ptr @.rt.f_eqshape, ptr %na, ptr %nb)|  unreachable|go:|  %n = call i64 @lep.ld(i64 %a, i64 8)|  store i64 0, ptr %ip|  br label %loop|loop:|  %i = load i64, ptr %ip|  %done = icmp sge i64 %i, %n|  br i1 %done, label %yes, label %body|body:|  %o1 = mul i64 %i, 8|  %o2 = add i64 %o1, 16|  %va = call i64 @lep.ld(i64 %a, i64 %o2)|  %vb = call i64 @lep.ld(i64 %b, i64 %o2)|  %e = call i1 @lep.veq(i64 %va, i64 %vb)|  br i1 %e, label %next, label %no|next:|  %i1 = add i64 %i, 1|  store i64 %i1, ptr %ip|  br label %loop|no:|  ret i1 false|yes:|  ret i1 true|}")
    rt(ctx, "define internal i64 @lep_eq(i64 %a, i64 %b) {|entry:|  %e = call i1 @lep.veq(i64 %a, i64 %b)|  %r = select i1 %e, i64 7, i64 6|  ret i64 %r|}")
    rt(ctx, "define internal i64 @lep_ne(i64 %a, i64 %b) {|entry:|  %e = call i1 @lep.veq(i64 %a, i64 %b)|  %r = select i1 %e, i64 6, i64 7|  ret i64 %r|}")
    rt(ctx, "define internal i32 @lep.vcmp(i64 %a, i64 %b, ptr %op) {|entry:|  %pv = alloca double|  %qv = alloca double|  %pd = alloca [8 x i32]|  %qd = alloca [8 x i32]|  %ka = call i32 @lep.kind(i64 %a)|  %kb = call i32 @lep.kind(i64 %b)|  %ta = icmp eq i32 %ka, 1|  %tb = icmp eq i32 %kb, 1|  %tt = and i1 %ta, %tb|  br i1 %tt, label %txt, label %q|txt:|  %c = call i32 @lep.tcmp(i64 %a, i64 %b)|  ret i32 %c|q:|  %g1 = call i1 @lep.getq(i64 %a, ptr %pv, ptr %pd)|  %g2 = call i1 @lep.getq(i64 %b, ptr %qv, ptr %qd)|  %g = and i1 %g1, %g2|  br i1 %g, label %num, label %bad")
    rt(ctx, "num:|  %x = load double, ptr %pv|  %y = load double, ptr %qv|  %lt = fcmp olt double %x, %y|  br i1 %lt, label %rlt, label %n2|rlt:|  ret i32 -1|n2:|  %gt = fcmp ogt double %x, %y|  br i1 %gt, label %rgt, label %n3|rgt:|  ret i32 1|n3:|  %eq = fcmp oeq double %x, %y|  br i1 %eq, label %req, label %run|req:|  ret i32 0|run:|  ret i32 2|bad:|  %kna = call ptr @lep.kname(i64 %a)|  %knb = call ptr @lep.kname(i64 %b)|  call void @lep.die3(ptr @.rt.f_needord, ptr %op, ptr %kna, ptr %knb)|  unreachable|}")
    cg_rt_order(ctx, "lt", "olt", "-1", "-1")
    cg_rt_order(ctx, "gt", "ogt", "1", "1")
    cg_rt_order(ctx, "le", "ole", "-1", "0")
    cg_rt_order(ctx, "ge", "oge", "1", "0")
    rt(ctx, "define internal i64 @lep_and(i64 %a, i64 %b) {|entry:|  %ba = call i1 @lep.isbool(i64 %a)|  %bb = call i1 @lep.isbool(i64 %b)|  %ok = and i1 %ba, %bb|  br i1 %ok, label %go, label %bad|bad:|  call void @lep.die(ptr @.rt.m_and)|  unreachable|go:|  %ta = icmp eq i64 %a, 7|  %tb = icmp eq i64 %b, 7|  %r = and i1 %ta, %tb|  %v = select i1 %r, i64 7, i64 6|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep_or(i64 %a, i64 %b) {|entry:|  %ba = call i1 @lep.isbool(i64 %a)|  %bb = call i1 @lep.isbool(i64 %b)|  %ok = and i1 %ba, %bb|  br i1 %ok, label %go, label %bad|bad:|  call void @lep.die(ptr @.rt.m_or)|  unreachable|go:|  %ta = icmp eq i64 %a, 7|  %tb = icmp eq i64 %b, 7|  %r = or i1 %ta, %tb|  %v = select i1 %r, i64 7, i64 6|  ret i64 %v|}")
    rt(ctx, "define internal i64 @lep_not(i64 %a) {|entry:|  %ba = call i1 @lep.isbool(i64 %a)|  br i1 %ba, label %go, label %bad|bad:|  call void @lep.die(ptr @.rt.m_not)|  unreachable|go:|  %t = icmp eq i64 %a, 7|  %v = select i1 %t, i64 6, i64 7|  ret i64 %v|}")
    rt(ctx, "define internal i32 @lep_cond(i64 %v, i32 %which) {|entry:|  %t = icmp eq i64 %v, 7|  br i1 %t, label %yes, label %c1|yes:|  ret i32 1|c1:|  %f = icmp eq i64 %v, 6|  br i1 %f, label %no, label %bad|no:|  ret i32 0|bad:|  %w1 = icmp eq i32 %which, 1|  %w2 = icmp eq i32 %which, 2|  %n1 = select i1 %w1, ptr @.rt.cn_until, ptr @.rt.cn_when|  %n2 = select i1 %w2, ptr @.rt.cn_wait, ptr %n1|  %kn = call ptr @lep.kname(i64 %v)|  call void @lep.die2(ptr @.rt.f_cond, ptr %n2, ptr %kn)|  unreachable|}")
    rt(ctx, "define internal i64 @lep.whole(i64 %v, ptr %what) {|entry:|  %n = call i1 @lep.isnum(i64 %v)|  br i1 %n, label %ok, label %bad|ok:|  %d = call double @lep.dec(i64 %v)|  %i = fptosi double %d to i64|  ret i64 %i|bad:|  %kn = call ptr @lep.kname(i64 %v)|  call void @lep.die2(ptr @.rt.f_whole, ptr %what, ptr %kn)|  unreachable|}")
    rt(ctx, "define internal i64 @lep_count(i64 %v) {|entry:|  %r = call i64 @lep.whole(i64 %v, ptr @.rt.w_repeat)|  ret i64 %r|}")
    cg_rt_bitwise(ctx)
    rt_str(ctx, "f_choose_kind", "LEC8029: `choose`: case label type mismatch - the value is %s, case label is %s")
    rt_str(ctx, "f_choose_unit", "LEC8029: `choose`: case label %s has a different unit than the value %s")
    rt(ctx, "define internal void @lep_choose_check(i64 %v, i64 %l) {|entry:|  %pv = alloca double|  %pd = alloca [8 x i32]|  %qv = alloca double|  %qd = alloca [8 x i32]|  %kv = call ptr @lep.kname(i64 %v)|  %kl = call ptr @lep.kname(i64 %l)|  %c = call i32 @strcmp(ptr %kv, ptr %kl)|  %same = icmp eq i32 %c, 0|  br i1 %same, label %kind_ok, label %bad_kind|bad_kind:|  call void @lep.die2(ptr @.rt.f_choose_kind, ptr %kv, ptr %kl)|  unreachable|kind_ok:|  %g1 = call i1 @lep.getq(i64 %v, ptr %pv, ptr %pd)|  br i1 %g1, label %num, label %ok|num:|  %g2 = call i1 @lep.getq(i64 %l, ptr %qv, ptr %qd)|  %e = call i1 @lep.dimeq(ptr %pd, ptr %qd)|  br i1 %e, label %ok, label %bad_unit|bad_unit:|  %fl = call i64 @lep.format(i64 %l)|  %fv = call i64 @lep.format(i64 %v)|  %pl = call ptr @lep.tchars(i64 %fl)|  %pw = call ptr @lep.tchars(i64 %fv)|  call void @lep.die2(ptr @.rt.f_choose_unit, ptr %pl, ptr %pw)|  unreachable|ok:|  ret void|}")
done()

(* bitwise operators: dimensionless whole-number operands only, 64-bit
   integer semantics, result a plain Number - the host's exact rules.
   Shift counts are taken mod 64. *)
make cg_rt_bitwise(ctx)
    rt_str(ctx, "op_band", "&")
    rt_str(ctx, "op_bor", "|")
    rt_str(ctx, "op_bxor", "^")
    rt_str(ctx, "op_shl", "<<")
    rt_str(ctx, "op_shr", ">>")
    rt_str(ctx, "op_bnot", "~")
    rt_str(ctx, "f_bitop", "`%s` requires dimensionless whole-number operands")
    rt_str(ctx, "f_bitfrac", "`%s` requires a whole-number operand, got a fractional value")
    rt(ctx, "define internal i64 @lep.bitint(i64 %v, ptr %op) {|entry:|  %isn = call i1 @lep.isnum(i64 %v)|  br i1 %isn, label %ok, label %bad|bad:|  call void @lep.die1(ptr @.rt.f_bitop, ptr %op)|  unreachable|ok:|  %d = call double @lep.dec(i64 %v)|  %fr = call double @fmod(double %d, double 1.0)|  %whole = fcmp oeq double %fr, 0.0|  br i1 %whole, label %good, label %frac|frac:|  call void @lep.die1(ptr @.rt.f_bitfrac, ptr %op)|  unreachable|good:|  %i = fptosi double %d to i64|  ret i64 %i|}")
    cg_rt_bitop(ctx, "band", "and i64 %x, %y")
    cg_rt_bitop(ctx, "bor", "or i64 %x, %y")
    cg_rt_bitop(ctx, "bxor", "xor i64 %x, %y")
    cg_rt_bitop(ctx, "shl", "shl i64 %x, %s")
    cg_rt_bitop(ctx, "shr", "ashr i64 %x, %s")
    rt(ctx, "define internal i64 @lep_bnot(i64 %a) {|entry:|  %x = call i64 @lep.bitint(i64 %a, ptr @.rt.op_bnot)|  %r = xor i64 %x, -1|  %v = call i64 @lep.num(i64 %r)|  ret i64 %v|}")
done()

make cg_rt_bitop(ctx, name, instr)
    rt(ctx, "define internal i64 @lep_" + name + "(i64 %a, i64 %b) {|entry:|  %x = call i64 @lep.bitint(i64 %a, ptr @.rt.op_" + name + ")|  %y = call i64 @lep.bitint(i64 %b, ptr @.rt.op_" + name + ")|  %s = and i64 %y, 63|  %r = " + instr + "|  %v = call i64 @lep.num(i64 %r)|  ret i64 %v|}")
done()

(* one ordering operator: a fast path for two plain Numbers, otherwise
   @lep.vcmp's -1/0/1 (2 = unordered NaN, never true) *)
make cg_rt_order(ctx, name, pred, c1, c2)
    rt(ctx, "define internal i64 @lep_" + name + "(i64 %a, i64 %b) {|entry:|  %an = call i1 @lep.isnum(i64 %a)|  %bn = call i1 @lep.isnum(i64 %b)|  %nn = and i1 %an, %bn|  br i1 %nn, label %fast, label %slow|fast:|  %x = call double @lep.dec(i64 %a)|  %y = call double @lep.dec(i64 %b)|  %f = fcmp " + pred + " double %x, %y|  %fr = select i1 %f, i64 7, i64 6|  ret i64 %fr|slow:|  %c = call i32 @lep.vcmp(i64 %a, i64 %b, ptr @.rt.op_" + name + ")|  %m1 = icmp eq i32 %c, " + c1 + "|  %m2 = icmp eq i32 %c, " + c2 + "|  %m = or i1 %m1, %m2|  %r = select i1 %m, i64 7, i64 6|  ret i64 %r|}")
done()

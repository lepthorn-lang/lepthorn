(* parser_errors.lep - mistakes in how the program is put together
   (its grammar). LEC2xxx. *)

make add_parser_errors(list)
    add_error(list, "LEC2001", "expected_value",
        "expected a value, found {1}",
        "write a value here: a number, a name, a text, true or false")
    add_error(list, "LEC2002", "input_needs_name",
        "`take`/`read` needs a variable name",
        "write the name to read into: take mass")
    add_error(list, "LEC2003", "loop_hz_needs_frequency",
        "loop_hz needs a frequency: loop_hz(100) or loop_hz 100Hz",
        "give the rate after loop_hz")
    add_error(list, "LEC2004", "bad_statement_start",
        "a statement cannot start with {1}",
        "start the line with a keyword (ensure, show, when, ...) or a name")
    add_error(list, "LEC2005", "bad_case_label",
        "a case label must be a number, quoted Text, true or false, got '{1}'",
        "write the label as a literal value, not a name or an expression")
    add_error(list, "LEC2006", "show_spaced_minus",
        "this could be a - b, or two values",
        "write a - b with a space on both sides")
    add_error(list, "LEC2007", "show_comma",
        "show takes its values with spaces between them",
        "remove the comma")
    add_error(list, "LEC2008", "show_spaced_bracket",
        "this could be an item of the array, or two values",
        "write a[0] with no space before the bracket")
    add_error(list, "LEC2009", "show_spaced_call",
        "this could be a call, or two values",
        "write f(3) with no space before the bracket")
    add_error(list, "LEC2010", "missing_symbol",
        "expected {1}, found {2}",
        "write it here")
    add_error(list, "LEC2011", "name_expected",
        "expected a name, found {1}",
        "write a name: letters, digits and _, with a letter first")
    add_error(list, "LEC2012", "keyword_as_name",
        "`{1}` is a word of the language",
        "use another name")
    add_error(list, "LEC2017", "extra_comma",
        "nothing comes after this comma",
        "remove the comma")
    add_error(list, "LEC2021", "member_needs_call",
        "`{1}` is a function, it needs ( )",
        "write ( and the values, then )")
done()

(* realtime_errors.lep - timing. LER6xxx. Today these are warnings: the
   program goes on. Phase 2C makes a missed deadline an error. *)

make add_realtime_errors(list)
    add_error(list, "LER6001", "deadline_missed",
        "the block took {1}s, its deadline is {2}s",
        "make the block faster, or give it a longer deadline")
    add_error(list, "LER6002", "timeout_expired",
        "the wait did not end in time",
        "check what the wait is waiting for, or give it more time")
    add_error(list, "LER6003", "timeout_expired_after",
        "the wait did not end in time, waited {1}s",
        "check what the wait is waiting for, or give it more time")
done()

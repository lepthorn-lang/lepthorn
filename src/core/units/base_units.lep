(* base_units.lep - the 8 base units, and what a dimension is.

   Every quantity is made of 8 base units, each raised to a whole power:

     kg   mass             A    electric current     cd   light
     m    length           K    temperature          rad  angle
     s    time             mol  amount of substance

   A speed (meter per second) is m^1 s^-1: length 1, time -1.

   A unit's dimension is written as text, the way a physics book writes
   it (see dimension_from_text below):

     "m"            a length
     "m / s"        a speed
     "kg m / s^2"   a force
     "1 / s"        a frequency

   Compiled programs keep a dimension as 8 whole numbers ([8 x i32] in
   the run-time code, src/codegen/cg_rt_*.lep). Adding a 9th base unit
   means changing that size there too. *)

use core::errors

(* how many times each base unit appears *)
shape Dimension
    mass: Number            (* kg *)
    length: Number          (* m *)
    time: Number            (* s *)
    current: Number         (* A *)
    temperature: Number     (* K *)
    amount: Number          (* mol *)
    luminosity: Number      (* cd *)
    angle: Number           (* rad *)
done()

(* the dimension of a plain number: nothing *)
make no_dimension()
    done(Dimension(mass = 0, length = 0, time = 0, current = 0, temperature = 0, amount = 0, luminosity = 0, angle = 0))
done()

(* -- the base units by name -- *)

(* the 8 base unit names, in the order of the Dimension fields *)
make base_unit_names()
    done(["kg", "m", "s", "A", "K", "mol", "cd", "rad"])
done()

make is_base_unit(name)
    ensure names = base_unit_names()
    suppose i = 0
    repeat
        when i >= length(names)
            stop
        done()
        when names[i] == name
            done(true)
        done()
        i = i + 1
    done()
    done(false)
done()

(* how many times one base unit appears in a dimension *)
make power_of(d, name)
    when name == "kg"
        done(d.mass)
    otherwise when name == "m"
        done(d.length)
    otherwise when name == "s"
        done(d.time)
    otherwise when name == "A"
        done(d.current)
    otherwise when name == "K"
        done(d.temperature)
    otherwise when name == "mol"
        done(d.amount)
    otherwise when name == "cd"
        done(d.luminosity)
    done()
    done(d.angle)
done()

(* the same dimension, with `amount` more of one base unit *)
make add_power(d, name, amount)
    suppose mass = d.mass
    suppose len = d.length
    suppose time = d.time
    suppose current = d.current
    suppose temperature = d.temperature
    suppose substance = d.amount
    suppose luminosity = d.luminosity
    suppose angle = d.angle
    when name == "kg"
        mass = mass + amount
    otherwise when name == "m"
        len = len + amount
    otherwise when name == "s"
        time = time + amount
    otherwise when name == "A"
        current = current + amount
    otherwise when name == "K"
        temperature = temperature + amount
    otherwise when name == "mol"
        substance = substance + amount
    otherwise when name == "cd"
        luminosity = luminosity + amount
    otherwise when name == "rad"
        angle = angle + amount
    done()
    done(Dimension(mass = mass, length = len, time = time, current = current, temperature = temperature, amount = substance, luminosity = luminosity, angle = angle))
done()

(* -- working with dimensions -- *)

make same_dimension(a, b)
    ensure names = base_unit_names()
    suppose i = 0
    repeat
        when i >= length(names)
            stop
        done()
        when power_of(a, names[i]) != power_of(b, names[i])
            done(false)
        done()
        i = i + 1
    done()
    done(true)
done()

(* a * b adds the powers; a / b takes them away *)
make multiply_dimensions(a, b)
    ensure names = base_unit_names()
    suppose result = a
    suppose i = 0
    repeat
        when i >= length(names)
            stop
        done()
        result = add_power(result, names[i], power_of(b, names[i]))
        i = i + 1
    done()
    done(result)
done()

make divide_dimensions(a, b)
    ensure names = base_unit_names()
    suppose result = a
    suppose i = 0
    repeat
        when i >= length(names)
            stop
        done()
        result = add_power(result, names[i], 0 - power_of(b, names[i]))
        i = i + 1
    done()
    done(result)
done()

(* -- a dimension written as text -- *)

(* "kg m / s^2" -> mass 1, length 1, time -2.

   Three ways to write the same dimension; all work:

       "kg / m s^2"          spaces (the way the unit files are written)
       "kg / (m * s^2)"      * between units, brackets to read it easily
       "kg * m^-1 * s^-2"    negative powers, no /

   Rules:
     - each word is a base unit: kg m s A K mol cd rad
     - spaces and * only separate words
     - every word after / goes below the line
     - only one / is allowed. A second / is an error (LEC3106), because
       a text such as "a / b * c" could be read two ways: as a / (b c),
       with c below the line, or as (a / b) c, with c above it. With
       one / there is only one meaning: everything after it is below.
     - ^2 or ^-1 is a whole-number power
     - brackets are only for reading; they must match
     - "1" means nothing, as in "1 / s"
   `unit` is the unit being added, for the error message. *)
make dimension_from_text(written, unit)
    when not brackets_match(written)
        stop_with_error(error_block("unit_brackets", [unit, written], "in the unit list"))
    done()
    suppose result = no_dimension()
    suppose below = false
    suppose word = ""
    suppose i = 0
    repeat
        when i > text::length(written)
            stop
        done()
        (* one space after the end, so the last word is added too *)
        suppose c = " "
        when i < text::length(written)
            c = text::char_at(written, i)
        done()
        when is_separator(c)
            result = add_word(result, word, below, unit)
            word = ""
        otherwise when c == "/"
            result = add_word(result, word, below, unit)
            word = ""
            when below
                stop_with_error(error_block("unit_two_slashes", [unit, written], "in the unit list"))
            done()
            below = true
        otherwise
            word = word + c
        done()
        i = i + 1
    done()
    done(result)
done()

(* a character that only separates words *)
make is_separator(c)
    when c == " " or c == "*"
        done(true)
    done()
    done(c == "(" or c == ")")
done()

(* true when every ( has its ) *)
make brackets_match(written)
    suppose open = 0
    suppose i = 0
    repeat
        when i >= text::length(written)
            stop
        done()
        ensure c = text::char_at(written, i)
        when c == "("
            open = open + 1
        otherwise when c == ")"
            open = open - 1
        done()
        when open < 0
            done(false)
        done()
        i = i + 1
    done()
    done(open == 0)
done()

(* one word of a dimension text, such as "s^2" or "m^-1", added to `d` *)
make add_word(d, word, below, unit)
    when word == "" or word == "1"
        done(d)
    done()
    suppose name = word
    suppose power = 1
    ensure hat = text_index(word, "^")
    when hat >= 0
        name = text::slice(word, 0, hat)
        ensure power_text = text::slice(word, hat + 1, text::length(word))
        when not is_whole_number_text(power_text)
            stop_with_error(error_block("unit_power_not_whole", [unit, word], "in the unit list"))
        done()
        power = text::to_number(power_text)
    done()
    when not is_base_unit(name)
        stop_with_error(error_block("unit_not_base", [unit, name], "in the unit list"))
    done()
    when below
        power = 0 - power
    done()
    done(add_power(d, name, power))
done()

(* "2", "-1", "12": digits, with one - in front allowed *)
make is_whole_number_text(t)
    suppose start = 0
    when text::length(t) > 0
        when text::char_at(t, 0) == "-"
            start = 1
        done()
    done()
    when start >= text::length(t)
        done(false)
    done()
    suppose i = start
    repeat
        when i >= text::length(t)
            stop
        done()
        ensure c = text::char_at(t, i)
        when c < "0" or c > "9"
            done(false)
        done()
        i = i + 1
    done()
    done(true)
done()

(* where `part` starts in `text`, or -1 *)
make text_index(whole, part)
    ensure n = text::length(part)
    suppose i = 0
    repeat
        when i + n > text::length(whole)
            stop
        done()
        when text::slice(whole, i, i + n) == part
            done(i)
        done()
        i = i + 1
    done()
    done(0 - 1)
done()

(* -- a number with a dimension, as a real value -- *)

(* 3 with mass 1 and time -2 becomes 3 kg/s². Each base unit is raised
   to its power and multiplied in; a power of 0 gives 1 and changes
   nothing. This is the same run-time arithmetic as in any program. *)
make make_quantity(magnitude, d)
    when same_dimension(d, no_dimension())
        done(magnitude)
    done()
    suppose result = magnitude
    result = result * (1kg ** d.mass)
    result = result * (1m ** d.length)
    result = result * (1s ** d.time)
    result = result * (1A ** d.current)
    result = result * (1K ** d.temperature)
    result = result * (1mol ** d.amount)
    result = result * (1cd ** d.luminosity)
    result = result * (1rad ** d.angle)
    done(result)
done()

(* -- the names of common dimensions, for messages -- *)

(* "m/s" -> "speed"; "" when there is no common name *)
make dimension_name(unit)
    when unit == "kg"
        done("mass")
    otherwise when unit == "m"
        done("length")
    otherwise when unit == "s"
        done("time")
    otherwise when unit == "A"
        done("current")
    otherwise when unit == "K"
        done("temperature")
    otherwise when unit == "mol"
        done("amount")
    otherwise when unit == "cd"
        done("light")
    otherwise when unit == "rad"
        done("angle")
    otherwise when unit == "m²"
        done("area")
    otherwise when unit == "m/s"
        done("speed")
    otherwise when unit == "m/s²"
        done("acceleration")
    otherwise when unit == "kg·m/s²"
        done("force")
    otherwise when unit == "1/s"
        done("frequency")
    otherwise when unit == "kg/(m·s²)"
        done("pressure")
    done()
    done("")
done()

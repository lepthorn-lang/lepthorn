(* si_units.lep - the SI units.

   To add a unit, write one line:

       add_unit(list, "name", "dimension", size in SI)

   name       what is written after a number: 25km
   dimension  what the unit is made of, in base units (kg m s A K mol
              cd rad). Units below the line come after "/"; ^2 is a
              power. "m / s" is a speed, "kg m / s^2" a force, "1 / s"
              a frequency.
   size       how many SI units one of it is: 1 km is 1000 m, so 1000.

   Example, a new unit for pressure:
       add_unit(list, "Pa", "kg / m s^2", 1)

   Write only one /, and put everything that goes below the line
   after it: "kg / m s^2" is kg over (m s^2). A second / is an error,
   because "a / b * c" could mean a / (b c) or (a / b) c.

   Write every dimension in this one style (spaces, one /), so all
   unit files read the same. The parser also takes "kg / (m * s^2)"
   and "kg * m^-1 * s^-2" (see base_units.lep), but in the unit files
   only the space style is written. *)

make add_si_units(list)
    (* mass *)
    add_unit(list, "kg", "kg", 1)
    add_unit(list, "g", "kg", 0.001)
    add_unit(list, "t", "kg", 1000)

    (* length *)
    add_unit(list, "m", "m", 1)
    add_unit(list, "km", "m", 1000)
    add_unit(list, "cm", "m", 0.01)
    add_unit(list, "mm", "m", 0.001)

    (* time *)
    add_unit(list, "s", "s", 1)
    add_unit(list, "ms", "s", 0.001)
    add_unit(list, "min", "s", 60)
    add_unit(list, "h", "s", 3600)

    (* force *)
    add_unit(list, "N", "kg m / s^2", 1)
    add_unit(list, "kN", "kg m / s^2", 1000)
    add_unit(list, "MN", "kg m / s^2", 1000000)

    (* speed: meters per second *)
    add_unit(list, "mps", "m / s", 1)

    (* frequency *)
    add_unit(list, "Hz", "1 / s", 1)
    add_unit(list, "kHz", "1 / s", 1000)

    (* angle: one degree is pi / 180 radians *)
    add_unit(list, "rad", "rad", 1)
    add_unit(list, "degree", "rad", 0.017453292519943295)
    add_unit(list, "deg", "rad", 0.017453292519943295)

    (* electric current *)
    add_unit(list, "A", "A", 1)
    add_unit(list, "mA", "A", 0.001)

    (* temperature, in kelvin *)
    add_unit(list, "K", "K", 1)

    (* amount of substance *)
    add_unit(list, "mol", "mol", 1)

    (* light *)
    add_unit(list, "cd", "cd", 1)

    (* pressure: pascal *)
    add_unit(list, "Pa", "kg / m s^2", 1)
    add_unit(list, "kPa", "kg / m s^2", 1000)
    add_unit(list, "mPa", "kg / m s^2", 1000000)

done()

(* registrar.lep - the list of all units, and what a dimension is.

   build_unit_table makes the list. Each group of units lives in its
   own folder and adds itself here: general_units/ (SI), IEEE/ and
   American/. Every part of the compiler reads units from this one
   list, so a new unit is written in one place only.

   A unit written after a number (25km) is looked up in this list when
   the program is compiled. An unknown name comes back with an empty
   suffix, and the caller reports the error. *)

(* What a quantity is made of: how many times each SI base unit
   appears. A speed (meter per second) has m = 1 and s = -1. *)
shape Dimension
    kg: Number
    m: Number
    s: Number
    a: Number
    k: Number
    mol: Number
    cd: Number
    rad: Number
done()

(* One unit: its name, what it is made of, and how many SI units one of
   it is (1 km is 1000 m). *)
shape UnitEntry
    suffix: Text
    dim: Dimension
    scale: Number
done()

(* the dimension of a plain number with no unit: all zero *)
make dim_zero()
    done(Dimension(kg = 0, m = 0, s = 0, a = 0, k = 0, mol = 0, cd = 0, rad = 0))
done()

(* true when two dimensions are the same, field by field *)
make dim_equal(d1, d2)
    when d1.kg != d2.kg
        done(false)
    done()
    when d1.m != d2.m
        done(false)
    done()
    when d1.s != d2.s
        done(false)
    done()
    when d1.a != d2.a
        done(false)
    done()
    when d1.k != d2.k
        done(false)
    done()
    when d1.mol != d2.mol
        done(false)
    done()
    when d1.cd != d2.cd
        done(false)
    done()
    when d1.rad != d2.rad
        done(false)
    done()
    done(true)
done()

(* The list of units. A ring has a fixed size, so the list keeps its
   ring in `items` and swaps in a ring twice as big when it is full.
   So there is no limit on how many units can be added. *)
shape UnitList
    items: Number
done()

(* adds one unit to the list, making room first when it is full *)
make add_unit(list, suffix, dim, scale)
    when ring::is_full(list.items)
        grow_unit_list(list)
    done()
    ring::write(list.items, UnitEntry(suffix = suffix, dim = dim, scale = scale))
done()

(* moves every unit into a new ring twice as big *)
make grow_unit_list(list)
    ensure old = list.items
    ensure bigger = ring::create(ring::size(old) * 2)
    suppose i = 0
    repeat
        when i >= ring::size(old)
            stop
        done()
        ring::write(bigger, ring::peek(old, i))
        i = i + 1
    done()
    list.items = bigger
done()

(* how many units the list has *)
make unit_count(list)
    done(ring::size(list.items))
done()

(* the unit at place i: 0 is the first one added *)
make unit_at(list, i)
    done(ring::peek(list.items, i))
done()

(* makes the list of all units, one group after another *)
make build_unit_table()
    ensure list = UnitList(items = ring::create(16))
    add_si_units(list)
    add_ieee_units(list)
    add_american_units(list)
    done(list)
done()

(* finds a unit by its name; searches from the last unit added *)
make lookup_unit(list, suffix)
    when suffix == ""
        done(UnitEntry(suffix = "", dim = dim_zero(), scale = 1))
    done()
    ensure n = unit_count(list)
    suppose i = n - 1
    repeat
        when i < 0
            stop
        done()
        ensure entry = unit_at(list, i)
        when entry.suffix == suffix
            done(entry)
        done()
        i = i - 1
    done()
    done(UnitEntry(suffix = "", dim = dim_zero(), scale = 1))
done()

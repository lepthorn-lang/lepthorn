(* manifest.lep - reads manifest.lepm.

   A line is a section header, [Package] [Target] [Test] [Profile]
   [Target_<triple>], or `key = value` belonging to the section above
   it. [Target], [Profile] and [Target_<triple>] may repeat; the name
   of a [Target_<triple>] must match its `triple`. A value is quoted
   text or a list of quoted texts, ["a", "b"]. Comments are (* ... *),
   which may span lines and nest, or a line starting with # or //. Unknown sections and keys are errors, so a
   misspelling never passes silently. Paths are relative to the project
   root; absolute ones are refused. The older flat form (project/kind/
   entry, no sections) is still read. *)

shape MfEntry
    block: Text
    inst: Number
    key: Text
    value: Text
    is_list: Boolean
    line: Number
done()

shape Manifest
    entries: Number
done()

shape MfState
    block: Text
    inst: Number
    blocks: Number
    legacy_line: Number
done()

(* an error in the manifest: the line is shown between the thorns *)
make mf_fail(line, error)
    when line > 0
        ensure where = "manifest.lepm:" + text::from_number(line)
        print_error(where, between_thorns(mf_line_text(line)), error)
    otherwise
        print_error("manifest.lepm", "", error)
    done()
    sys::exit(2)
done()

(* the text of one line of the manifest *)
make mf_line_text(line)
    ensure new_line = text::from_code(10)
    ensure body = drv_read("manifest.lepm")
    suppose at = 1
    suppose words = ""
    suppose i = 0
    repeat
        when i >= text::length(body) or at > line
            stop
        done()
        ensure c = text::char_at(body, i)
        when c == new_line
            at = at + 1
        otherwise when at == line
            words = words + c
        done()
        i = i + 1
    done()
    done(drv_trim(words))
done()

make mf_word_in(word, words)
    done(drv_contains(" " + words + " ", " " + word + " "))
done()

make mf_sections()
    done("[Package] [Target] [Test] [Profile] [Target_<triple>]")
done()

(* [Target_x86_64-linux-gnu] -> target_platform, the name used inside;
   "" if unknown *)
make mf_section_kind(header)
    when header == "[Package]"
        done("package")
    done()
    when header == "[Target]"
        done("target")
    done()
    when header == "[Test]"
        done("test")
    done()
    when header == "[Profile]"
        done("profile")
    done()
    when drv_starts_with(header, "[Target_") and drv_ends_with(header, "]") and text::length(header) > 9
        done("target_platform")
    done()
    done("")
done()

make mf_section_name(kind)
    when kind == "package"
        done("[Package]")
    done()
    when kind == "target"
        done("[Target]")
    done()
    when kind == "test"
        done("[Test]")
    done()
    when kind == "profile"
        done("[Profile]")
    done()
    done("[Target_<triple>]")
done()

(* the keys each section takes *)
make mf_keys(block)
    when block == "package"
        done("name version description authors license license_file readme repository homepage")
    done()
    when block == "target"
        done("name kind source")
    done()
    when block == "test"
        done("tests")
    done()
    when block == "profile"
        done("name optimization")
    done()
    when block == "target_platform"
        done("triple libc link libraries")
    done()
    done("")
done()

make mf_legacy_keys()
    done("project version kind entry tests lepthorn")
done()

make mf_is_ident(s)
    when s == ""
        done(false)
    done()
    suppose i = 0
    repeat
        when i >= text::length(s)
            stop
        done()
        ensure c = text::char_at(s, i)
        when not (is_alnum(c) or c == "_")
            done(false)
        done()
        i = i + 1
    done()
    done(true)
done()

(* names that become file names, symbols and -l flags: letters, digits,
   _ . - but not starting with - or . *)
make mf_is_name(s)
    when s == ""
        done(false)
    done()
    when drv_starts_with(s, "-") or drv_starts_with(s, ".")
        done(false)
    done()
    suppose i = 0
    repeat
        when i >= text::length(s)
            stop
        done()
        ensure c = text::char_at(s, i)
        when not (is_alnum(c) or c == "_" or c == "-" or c == ".")
            done(false)
        done()
        i = i + 1
    done()
    done(true)
done()

make mf_count(m, block)
    suppose n = 0
    suppose i = 0
    repeat
        when i >= ring::size(m.entries)
            stop
        done()
        ensure e = ring::peek(m.entries, i)
        when e.block == block and e.key == ""
            n = n + 1
        done()
        i = i + 1
    done()
    done(n)
done()

make mf_entry_index(m, block, inst, key)
    suppose i = 0
    repeat
        when i >= ring::size(m.entries)
            stop
        done()
        ensure e = ring::peek(m.entries, i)
        when e.block == block and e.inst == inst and e.key == key
            done(i)
        done()
        i = i + 1
    done()
    done(0 - 1)
done()

make mf_has(m, block, inst, key)
    done(mf_entry_index(m, block, inst, key) >= 0)
done()

(* a value, or "" when absent; list items come back one per line *)
make mf_get(m, block, inst, key)
    ensure i = mf_entry_index(m, block, inst, key)
    when i < 0
        done("")
    done()
    ensure e = ring::peek(m.entries, i)
    done(e.value)
done()

(* the line to blame for a key, or for its block when the key is missing *)
make mf_line(m, block, inst, key)
    suppose i = mf_entry_index(m, block, inst, key)
    when i < 0
        i = mf_entry_index(m, block, inst, "")
    done()
    when i < 0
        done(0)
    done()
    ensure e = ring::peek(m.entries, i)
    done(e.line)
done()

(* the block of this kind whose `key` is `value`, or -1 *)
make mf_find(m, block, key, value)
    suppose inst = 0
    repeat
        when inst >= mf_count(m, block)
            stop
        done()
        when mf_get(m, block, inst, key) == value
            done(inst)
        done()
        inst = inst + 1
    done()
    done(0 - 1)
done()

(* `key` of every block of this kind, comma-separated, for messages *)
make mf_names(m, block, key)
    suppose outs = ""
    suppose inst = 0
    repeat
        when inst >= mf_count(m, block)
            stop
        done()
        when inst > 0
            outs = outs + ", "
        done()
        outs = outs + mf_get(m, block, inst, key)
        inst = inst + 1
    done()
    done(outs)
done()

make mf_items(value)
    ensure items = ring::create(text::length(value) + 1)
    when value == ""
        done(items)
    done()
    ensure nl = text::from_code(10)
    suppose start = 0
    suppose i = 0
    repeat
        when i > text::length(value)
            stop
        done()
        suppose at_break = i == text::length(value)
        when not at_break
            at_break = text::char_at(value, i) == nl
        done()
        when at_break
            ring::write(items, text::slice(value, start, i))
            start = i + 1
        done()
        i = i + 1
    done()
    done(items)
done()

make mf_skip_spaces(s, i)
    suppose j = i
    repeat
        when j >= text::length(s)
            stop
        done()
        when not drv_is_space(text::char_at(s, j))
            stop
        done()
        j = j + 1
    done()
    done(j)
done()

make mf_text_value(raw, line)
    ensure q = text::from_code(34)
    ensure n = text::length(raw)
    when n < 2
        mf_fail(line, error_line("value_not_quoted", [raw]))
    done()
    when text::char_at(raw, 0) != q or text::char_at(raw, n - 1) != q
        mf_fail(line, error_line("value_not_quoted", [raw]))
    done()
    ensure inner = text::slice(raw, 1, n - 1)
    when drv_contains(inner, q)
        mf_fail(line, error_line("value_has_quote", [raw]))
    done()
    done(inner)
done()

(* ["a", "b"] -> "a\nb" *)
make mf_list_value(raw, line)
    ensure q = text::from_code(34)
    ensure n = text::length(raw)
    when not drv_ends_with(raw, "]") or n < 2
        mf_fail(line, error_line("list_not_closed", [raw]))
    done()
    ensure inner = text::slice(raw, 1, n - 1)
    ensure m = text::length(inner)
    suppose items = ""
    suppose count = 0
    suppose i = mf_skip_spaces(inner, 0)
    repeat
        when i >= m
            stop
        done()
        when text::char_at(inner, i) != q
            mf_fail(line, error_line("list_item_not_quoted", [raw]))
        done()
        suppose close = i + 1
        repeat
            when close >= m
                mf_fail(line, error_line("list_quote_open", [raw]))
            done()
            when text::char_at(inner, close) == q
                stop
            done()
            close = close + 1
        done()
        when count > 0
            items = items + text::from_code(10)
        done()
        items = items + text::slice(inner, i + 1, close)
        count = count + 1
        i = mf_skip_spaces(inner, close + 1)
        when i < m
            when text::char_at(inner, i) != ","
                mf_fail(line, error_line("list_no_comma", [raw]))
            done()
            i = mf_skip_spaces(inner, i + 1)
        done()
    done()
    done(items)
done()

make mf_handle_line(st, entries, line, lineno)
    when line == "" or drv_starts_with(line, "#") or drv_starts_with(line, "//")
        done(true)
    done()
    when drv_starts_with(line, "[")
        ensure kind = mf_section_kind(line)
        when kind == ""
            mf_fail(lineno, error_line("unknown_section", [line, mf_sections()]))
        done()
        ensure probe = Manifest(entries = entries)
        ensure sinst = mf_count(probe, kind)
        (* a [Target_<triple>] header keeps its <triple> as its value *)
        suppose sname = ""
        when kind == "target_platform"
            sname = text::slice(line, 8, text::length(line) - 1)
        done()
        ring::write(entries, MfEntry(block = kind, inst = sinst, key = "", value = sname, is_list = false, line = lineno))
        st.block = kind
        st.inst = sinst
        st.blocks = st.blocks + 1
        done(true)
    done()
    ensure eq = drv_first_index(line, "=")
    when eq >= text::length(line)
        mf_fail(lineno, error_line("not_a_manifest_line", [line]))
    done()
    ensure key = drv_trim(text::slice(line, 0, eq))
    ensure raw = drv_trim(text::slice(line, eq + 1, text::length(line)))
    when not mf_is_ident(key)
        mf_fail(lineno, error_line("bad_key", [key]))
    done()
    suppose inst = 0
    when st.block != ""
        inst = st.inst
    done()
    when st.block == ""
        when not mf_word_in(key, mf_legacy_keys())
            mf_fail(lineno, error_line("key_outside_section", [key, mf_sections()]))
        done()
        when st.legacy_line == 0
            st.legacy_line = lineno
        done()
    otherwise when not mf_word_in(key, mf_keys(st.block))
        mf_fail(lineno, error_line("unknown_key", [key, mf_section_name(st.block), mf_keys(st.block)]))
    done()
    when mf_has(Manifest(entries = entries), st.block, inst, key)
        mf_fail(lineno, error_line("key_twice", [key]))
    done()
    ensure is_list = drv_starts_with(raw, "[")
    (* `tests` takes one folder or file, or a list of them *)
    ensure takes_both = key == "tests"
    when not takes_both and is_list != mf_word_in(key, "authors libraries")
        when is_list
            mf_fail(lineno, error_line("key_wants_text", [key]))
        done()
        mf_fail(lineno, error_line("key_wants_list", [key]))
    done()
    suppose value = ""
    when is_list
        value = mf_list_value(raw, lineno)
    otherwise
        value = mf_text_value(raw, lineno)
    done()
    ring::write(entries, MfEntry(block = st.block, inst = inst, key = key, value = value, is_list = is_list, line = lineno))
    done(true)
done()

make mf_add(entries, block, inst, key, value)
    ring::write(entries, MfEntry(block = block, inst = inst, key = key, value = value, is_list = false, line = 0))
done()

(* the flat form, rewritten as [Package], [Target] and [Test] *)
make mf_from_legacy(m)
    ensure entries = ring::create(16)
    ensure kind = mf_get(m, "", 0, "kind")
    suppose tkind = "bin"
    when kind == "library"
        tkind = "library"
    otherwise when kind != "" and kind != "application"
        mf_fail(mf_line(m, "", 0, "kind"), error_line("old_kind", [kind]))
    done()
    mf_add(entries, "package", 0, "", "")
    mf_add(entries, "package", 0, "name", mf_get(m, "", 0, "project"))
    mf_add(entries, "package", 0, "version", mf_get(m, "", 0, "version"))
    mf_add(entries, "target", 0, "", "")
    mf_add(entries, "target", 0, "name", mf_get(m, "", 0, "project"))
    mf_add(entries, "target", 0, "kind", tkind)
    mf_add(entries, "target", 0, "source", mf_get(m, "", 0, "entry"))
    when mf_has(m, "", 0, "tests")
        mf_add(entries, "test", 0, "", "")
        mf_add(entries, "test", 0, "tests", mf_get(m, "", 0, "tests"))
    done()
    done(Manifest(entries = entries))
done()

(* blanks out (* ... *) comments, nested, keeping every newline so line
   numbers stay right; a (* or *) inside a quoted value is not a comment *)
make mf_strip_comments(body)
    ensure q = text::from_code(34)
    ensure nl = text::from_code(10)
    ensure n = text::length(body)
    suppose outs = ""
    suppose depth = 0
    suppose in_quote = false
    suppose line = 1
    suppose open_line = 0
    suppose i = 0
    repeat
        when i >= n
            stop
        done()
        ensure c = text::char_at(body, i)
        suppose pair = ""
        when i + 1 < n
            pair = text::slice(body, i, i + 2)
        done()
        when c == nl
            outs = outs + nl
            line = line + 1
            in_quote = false
            i = i + 1
        otherwise when depth == 0 and c == q
            in_quote = not in_quote
            outs = outs + c
            i = i + 1
        otherwise when not in_quote and pair == "(*"
            when depth == 0
                open_line = line
            done()
            depth = depth + 1
            outs = outs + "  "
            i = i + 2
        otherwise when not in_quote and pair == "*)"
            when depth == 0
                mf_fail(line, error_line_plain("manifest_comment_end"))
            done()
            depth = depth - 1
            outs = outs + "  "
            i = i + 2
        otherwise when depth > 0
            outs = outs + " "
            i = i + 1
        otherwise
            outs = outs + c
            i = i + 1
        done()
    done()
    when depth > 0
        mf_fail(open_line, error_line_plain("manifest_comment_open"))
    done()
    done(outs)
done()

make mf_parse(text_in)
    ensure body = mf_strip_comments(text_in)
    ensure entries = ring::create(text::length(body) + 16)
    ensure st = MfState(block = "", inst = 0, blocks = 0, legacy_line = 0)
    ensure nl = text::from_code(10)
    ensure n = text::length(body)
    suppose start = 0
    suppose lineno = 0
    suppose i = 0
    repeat
        when i > n
            stop
        done()
        suppose at_break = i == n
        when not at_break
            at_break = text::char_at(body, i) == nl
        done()
        when at_break
            lineno = lineno + 1
            mf_handle_line(st, entries, drv_trim(text::slice(body, start, i)), lineno)
            start = i + 1
        done()
        i = i + 1
    done()
    ensure m = Manifest(entries = entries)
    when st.legacy_line > 0
        when st.blocks > 0
            mf_fail(st.legacy_line, error_line_plain("old_flat_form"))
        done()
        done(mf_from_legacy(m))
    done()
    done(m)
done()

(* -- validation -- *)

make mf_require(m, block, inst, key)
    ensure v = mf_get(m, block, inst, key)
    when v == ""
        mf_fail(mf_line(m, block, inst, key), error_line("key_missing", [mf_section_name(block), key]))
    done()
    done(v)
done()

make mf_check_name(m, block, inst, key)
    ensure v = mf_require(m, block, inst, key)
    when not mf_is_name(v)
        mf_fail(mf_line(m, block, inst, key), error_line("bad_name", [key, v]))
    done()
    done(v)
done()

make mf_check_path(m, block, inst, key, must_exist)
    ensure v = mf_get(m, block, inst, key)
    when v == ""
        done(v)
    done()
    when drv_starts_with(v, "/") or drv_starts_with(v, "~")
        mf_fail(mf_line(m, block, inst, key), error_line("path_not_relative", [key, v]))
    done()
    when must_exist and not file::exists(v)
        mf_fail(mf_line(m, block, inst, key), error_line("path_missing", [key, v]))
    done()
    done(v)
done()

make mf_check_unique(m, block, key)
    suppose a = 0
    repeat
        when a >= mf_count(m, block)
            stop
        done()
        suppose b = a + 1
        repeat
            when b >= mf_count(m, block)
                stop
            done()
            when mf_get(m, block, a, key) == mf_get(m, block, b, key)
                mf_fail(mf_line(m, block, b, key), error_line("section_twice", [mf_section_name(block), key, mf_get(m, block, b, key)]))
            done()
            b = b + 1
        done()
        a = a + 1
    done()
done()

(* every folder or file in `tests` must be relative to the project root *)
make mf_check_test_paths(m)
    ensure items = mf_items(mf_get(m, "test", 0, "tests"))
    repeat
        when ring::is_empty(items)
            stop
        done()
        ensure path = ring::get(items)
        when drv_starts_with(path, "/") or drv_starts_with(path, "~")
            mf_fail(mf_line(m, "test", 0, "tests"), error_line("path_not_relative", ["tests", path]))
        done()
    done()
done()

(* SPDX license expression syntax: ids joined by AND / OR, an id WITH an
   exception, parentheses. Ids are not checked against the SPDX list. *)
make mf_spdx_ok(expr)
    suppose spaced = ""
    suppose i = 0
    repeat
        when i >= text::length(expr)
            stop
        done()
        ensure c = text::char_at(expr, i)
        when c == "(" or c == ")"
            spaced = spaced + " " + c + " "
        otherwise
            spaced = spaced + c
        done()
        i = i + 1
    done()
    suppose depth = 0
    suppose want_id = true
    suppose after_with = false
    suppose tokens = 0
    suppose start = 0
    i = 0
    repeat
        when i > text::length(spaced)
            stop
        done()
        suppose at_end = i == text::length(spaced)
        when not at_end
            at_end = text::char_at(spaced, i) == " "
        done()
        when at_end
            ensure tok = text::slice(spaced, start, i)
            start = i + 1
            when tok != ""
                tokens = tokens + 1
                when tok == "("
                    when not want_id or after_with
                        done(false)
                    done()
                    depth = depth + 1
                otherwise when tok == ")"
                    when want_id or depth == 0
                        done(false)
                    done()
                    depth = depth - 1
                otherwise when tok == "AND" or tok == "OR" or tok == "WITH"
                    when want_id
                        done(false)
                    done()
                    want_id = true
                    after_with = tok == "WITH"
                otherwise
                    when not want_id
                        done(false)
                    done()
                    suppose idp = tok
                    when drv_ends_with(tok, "+") and not after_with
                        idp = text::slice(tok, 0, text::length(tok) - 1)
                    done()
                    when not mf_is_name(idp)
                        done(false)
                    done()
                    want_id = false
                    after_with = false
                done()
            done()
        done()
        i = i + 1
    done()
    done(tokens > 0 and not want_id and depth == 0)
done()

make mf_opt_ok(o)
    done(mf_word_in(o, "none O0 O1 O2 O3 Os Oz"))
done()

(* checks everything that doesn't depend on the command being run;
   run from the project root *)
make mf_validate(m)
    when mf_count(m, "package") == 0
        mf_fail(0, error_line_plain("no_package"))
    done()
    when mf_count(m, "package") > 1
        mf_fail(mf_line(m, "package", 1, ""), error_line("one_section", ["[Package]"]))
    done()
    mf_check_name(m, "package", 0, "name")
    mf_require(m, "package", 0, "version")
    ensure lic = mf_get(m, "package", 0, "license")
    when lic != "" and not mf_spdx_ok(lic)
        mf_fail(mf_line(m, "package", 0, "license"), error_line("bad_license", [lic]))
    done()
    mf_check_path(m, "package", 0, "license_file", true)
    mf_check_path(m, "package", 0, "readme", true)
    when mf_count(m, "target") == 0
        mf_fail(0, error_line_plain("no_target"))
    done()
    suppose t = 0
    repeat
        when t >= mf_count(m, "target")
            stop
        done()
        mf_check_name(m, "target", t, "name")
        ensure kind = mf_require(m, "target", t, "kind")
        when kind != "bin" and kind != "library"
            mf_fail(mf_line(m, "target", t, "kind"), error_line("bad_target_kind", [kind]))
        done()
        mf_require(m, "target", t, "source")
        mf_check_path(m, "target", t, "source", true)
        t = t + 1
    done()
    mf_check_unique(m, "target", "name")
    when mf_count(m, "test") > 1
        mf_fail(mf_line(m, "test", 1, ""), error_line("one_section", ["[Test]"]))
    done()
    mf_check_test_paths(m)
    t = 0
    repeat
        when t >= mf_count(m, "profile")
            stop
        done()
        mf_check_name(m, "profile", t, "name")
        ensure o = mf_require(m, "profile", t, "optimization")
        when not mf_opt_ok(o)
            mf_fail(mf_line(m, "profile", t, "optimization"), error_line("bad_optimization", [o]))
        done()
        t = t + 1
    done()
    mf_check_unique(m, "profile", "name")
    t = 0
    repeat
        when t >= mf_count(m, "target_platform")
            stop
        done()
        ensure triple = mf_require(m, "target_platform", t, "triple")
        ensure tl = mf_line(m, "target_platform", t, "triple")
        ensure sname = mf_get(m, "target_platform", t, "")
        when sname != triple
            mf_fail(mf_line(m, "target_platform", t, ""), error_line("section_not_triple", [sname, triple]))
        done()
        when not drv_starts_with(triple, "x86_64-") or not drv_contains(triple, "-linux")
            mf_fail(tl, error_line("bad_triple", [triple]))
        done()
        ensure libc = mf_require(m, "target_platform", t, "libc")
        when libc != "glibc" and libc != "musl"
            mf_fail(mf_line(m, "target_platform", t, "libc"), error_line("bad_libc", [libc]))
        done()
        when (libc == "musl") != drv_ends_with(triple, "musl")
            mf_fail(mf_line(m, "target_platform", t, "libc"), error_line("libc_not_triple", [libc, triple]))
        done()
        ensure link = mf_get(m, "target_platform", t, "link")
        when link != "" and link != "static" and link != "dynamic"
            mf_fail(mf_line(m, "target_platform", t, "link"), error_line("bad_link", [link]))
        done()
        ensure libs = mf_items(mf_get(m, "target_platform", t, "libraries"))
        repeat
            when ring::is_empty(libs)
                stop
            done()
            ensure lib = ring::get(libs)
            when not mf_is_name(lib)
                mf_fail(mf_line(m, "target_platform", t, "libraries"), error_line("bad_library", [lib]))
            done()
        done()
        t = t + 1
    done()
    mf_check_unique(m, "target_platform", "triple")
    done(true)
done()

(* for single-file commands: no project, every setting at its default *)
make mf_empty()
    done(Manifest(entries = ring::create(1)))
done()
